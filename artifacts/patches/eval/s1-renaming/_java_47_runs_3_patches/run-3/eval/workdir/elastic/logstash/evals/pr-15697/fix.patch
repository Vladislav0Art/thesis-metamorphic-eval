+        private final ScheduledExecutorService executorService;
+
+        FixedRateTaskScheduler() {
+            executorService = Executors.newScheduledThreadPool(1, task -> {
+                Thread workerThread = new Thread(task);
+                //Allow this thread to die when the JVM dies
+                workerThread.setDaemon(true);
+                //Set the name
+                workerThread.setName("dlq-flush-check");
+                return workerThread;
+            });
+        }
+
+        @Override
+        public void recurringAction(Runnable task) {
+            executorService.scheduleAtFixedRate(task, 1L, 1L, TimeUnit.SECONDS);
+        }
+    }
