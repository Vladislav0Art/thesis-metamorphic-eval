+    public static String[] splitRawURLIntoParts(String rawUrlString, int pathEndIndex) {
+        String[] urlParts = new String[2];
+        int paramStartIndex = pathEndIndex + 3;//skip ENCODED_QUESTION_MARK
+        if (pathEndIndex == -1) {
+            pathEndIndex = rawUrlString.indexOf('?');
+            if (pathEndIndex == -1) {
+                // url with no params, decode anyway
+                rawUrlString = URL.decode(rawUrlString);
+            } else {
+                paramStartIndex = pathEndIndex + 1;
+            }
+        }
+        if (pathEndIndex >= 0) {
+            urlParts[0] = rawUrlString.substring(0, pathEndIndex);
+            urlParts[1] = rawUrlString.substring(paramStartIndex);
+        } else {
+            urlParts = new String[]{rawUrlString};
+        }
+        return urlParts;
+    }
+
+    public static Map<String, String> parseParameters(String rawParameters, boolean isEncodedFlag) {
+        if (isEncodedFlag) {
+            return parseUrlEncodedParams(rawParameters, 0);
+        }
+        return parseDecodedParameters(rawParameters, 0);
+    }
+
+    /**
+     * @param encodedUrlString : after {@link URL#encode(String)} string
+     *                      encodedURLStr after decode format: protocol://username:password@host:port/path?k1=v1&k2=v2
+     *                      [protocol://][username:password@][host:port]/[path][?k1=v1&k2=v2]
+     */
+    public static URL parseEncodedString(String encodedUrlString) {
+        Map<String, String> paramMap = null;
+        int pathEndIndex = encodedUrlString.toUpperCase().indexOf("%3F");// '?'
+        if (pathEndIndex >= 0) {
+            paramMap = parseUrlEncodedParams(encodedUrlString, pathEndIndex + 3);
+        } else {
+            pathEndIndex = encodedUrlString.length();
+        }
+
+        //decodedBody format: [protocol://][username:password@][host:port]/[path]
+        String decodedContent = decodeUrlComponent(encodedUrlString, 0, pathEndIndex, false, THREAD_LOCAL_TEMP_BUFFER.get());
+        return parseUrlBody(encodedUrlString, decodedContent, paramMap);
+    }
+
+    private static Map<String, String> parseUrlEncodedParams(String input, int startIndex) {
+        int length = input.length();
+        if (startIndex >= length) {
+            return Collections.emptyMap();
+        }
+
+        TempBuffer buffer = THREAD_LOCAL_TEMP_BUFFER.get();
+        Map<String, String> paramMap = new HashMap<>();
+        int nameStartIndex = startIndex;
+        int valueStartIndex = -1;
+        int idx;
+        for (idx = startIndex; idx < length; idx++) {
+            char currentChar = input.charAt(idx);
+            if (currentChar == '%') {
+                if (idx + 3 > length) {
+                    throw new IllegalArgumentException("unterminated escape sequence at index " + idx + " of: " + input);
+                }
+                currentChar = (char) decodeHexByte(input, idx + 1);
+                idx += 2;
+            }
+
+            switch (currentChar) {
+                case '=':
+                    if (nameStartIndex == idx) {
+                        nameStartIndex = idx + 1;
+                    } else if (valueStartIndex < nameStartIndex) {
+                        valueStartIndex = idx + 1;
+                    }
+                    break;
+                case ';':
+                case '&':
+                    addParameter(input, true, nameStartIndex, valueStartIndex, idx - 2, paramMap, buffer);
+                    nameStartIndex = idx + 1;
+                    break;
+                default:
+                    // continue
+            }
+        }
+        addParameter(input, true, nameStartIndex, valueStartIndex, idx, paramMap, buffer);
+        return paramMap;
+    }
+
+    private static boolean addParameter(String input, boolean encodedFlag, int nameStartIndex, int valueStartIndex, int valueEndIndex, Map<String, String> paramMap,
+                                        TempBuffer buffer) {
+        if (nameStartIndex >= valueEndIndex) {
+            return false;
+        }
+
+        if (valueStartIndex <= nameStartIndex) {
+            valueStartIndex = valueEndIndex + 1;
+        }
+
+        if (encodedFlag) {
+            String paramName = decodeUrlComponent(input, nameStartIndex, valueStartIndex - 3, false, buffer);
+            String paramValue;
+            if (valueStartIndex >= valueEndIndex) {
+                paramValue = paramName;
+            } else {
+                paramValue = decodeUrlComponent(input, valueStartIndex, valueEndIndex, false, buffer);
+            }
+            URLItemCache.putParams(paramMap, paramName, paramValue);
+            // compatible with lower versions registering "default." keys
+            if (paramName.startsWith(DEFAULT_KEY_PREFIX)) {
+                paramMap.putIfAbsent(paramName.substring(DEFAULT_KEY_PREFIX.length()), paramValue);
+            }
+        } else {
+            String paramName = input.substring(nameStartIndex, valueStartIndex - 1);
+            String paramValue;
+            if (valueStartIndex >= valueEndIndex) {
+                paramValue = paramName;
+            } else {
+                paramValue = input.substring(valueStartIndex, valueEndIndex);
+            }
+            URLItemCache.putParams(paramMap, paramName, paramValue);
+            // compatible with lower versions registering "default." keys
+            if (paramName.startsWith(DEFAULT_KEY_PREFIX)) {
+                paramMap.putIfAbsent(paramName.substring(DEFAULT_KEY_PREFIX.length()), paramValue);
+            }
+        }
+        return true;
+    }
+
+    private static String decodeUrlComponent(String source, int startIndex, int endExclusive, boolean pathFlag, TempBuffer buffer) {
+        int length = endExclusive - startIndex;
+        if (length <= 0) {
+            return EMPTY_STRING;
+        }
+
+        int firstEscapeIndex = -1;
+        for (int idx = startIndex; idx < endExclusive; idx++) {
+            char curChar = source.charAt(idx);
+            if (curChar == '%' || curChar == '+' && !pathFlag) {
+                firstEscapeIndex = idx;
+                break;
+            }
+        }
+        if (firstEscapeIndex == -1) {
+            return source.substring(startIndex, endExclusive);
+        }
+
+        // Each encoded byte takes 3 characters (e.g. "%20")
+        int decodedCap = (endExclusive - firstEscapeIndex) / 3;
+        byte[] byteBuf = buffer.byteBuffer(decodedCap);
+        char[] charBuffer = buffer.charBuffer(length);
+        source.getChars(startIndex, firstEscapeIndex, charBuffer, 0);
+
+        int charBufIndex = firstEscapeIndex - startIndex;
+        return decodePercentEncodedUtf8Component(source, firstEscapeIndex, endExclusive, pathFlag, byteBuf, charBuffer, charBufIndex);
+    }
+
+    private static String decodePercentEncodedUtf8Component(String input, int firstEscapeIndex, int endExclusive, boolean pathFlag, byte[] byteBuf,
+                                                            char[] charBuffer, int charBufIndex) {
+        int bufferIndex;
+        for (int idx = firstEscapeIndex; idx < endExclusive; idx++) {
+            char curChar = input.charAt(idx);
+            if (curChar != '%') {
+                charBuffer[charBufIndex++] = curChar != '+' || pathFlag ? curChar : BLANK_CHAR;
+                continue;
+            }
+
+            bufferIndex = 0;
+            do {
+                if (idx + 3 > endExclusive) {
+                    throw new IllegalArgumentException("unterminated escape sequence at index " + idx + " of: " + input);
+                }
+                byteBuf[bufferIndex++] = decodeHexByte(input, idx + 1);
+                idx += 3;
+            } while (idx < endExclusive && input.charAt(idx) == '%');
+            idx--;
+
+            charBufIndex += decodeUtf8(byteBuf, 0, bufferIndex, charBuffer, charBufIndex);
+        }
+        return new String(charBuffer, 0, charBufIndex);
+    }
+
+    private static int indexOfChar(String input, char currentChar, int startIndex, int toExcludeIndex) {
+        startIndex = Math.max(startIndex, 0);
+        toExcludeIndex = Math.min(toExcludeIndex, input.length());
+        if (startIndex > toExcludeIndex) {
+            return -1;
+        }
+
+        for (int idx = startIndex; idx < toExcludeIndex; idx++) {
+            if (input.charAt(idx) == currentChar) {
+                return idx;
+            }
+        }
+        return -1;
+    }
+
+    private static int lastIndexOfCharInRange(String input, char currentChar, int startIndex, int toExcludeIndex) {
+        startIndex = Math.max(startIndex, 0);
+        toExcludeIndex = Math.min(toExcludeIndex, input.length() - 1);
+        if (startIndex > toExcludeIndex) {
+            return -1;
+        }
+
+        for (int idx = toExcludeIndex; idx >= startIndex; idx--) {
+            if (input.charAt(idx) == currentChar) {
+                return idx;
+            }
+        }
+        return -1;
+    }
+
+    private static final class TempBuffer {
+
+        private final char[] bufferChars;
+
+        private final byte[] bufferBytes;
+
+        TempBuffer(int bufferSize) {
+            this.bufferChars = new char[bufferSize];
+            this.bufferBytes = new byte[bufferSize];
+        }
+
+        public char[] charBuffer(int bufferSize) {
+            char[] bufferChars = this.bufferChars;
+            if (bufferSize <= bufferChars.length) {
+                return bufferChars;
+            }
+            return new char[bufferSize];
+        }
+
+        public byte[] byteBuffer(int bufferSize) {
+            byte[] bufferBytes = this.bufferBytes;
+            if (bufferSize <= bufferBytes.length) {
+                return bufferBytes;
+            }
+            return new byte[bufferSize];
+        }
+    }
+}
