+public final class URLStringParser {
+    public static final String ENCODED_QUESTION_MARK = "%3F";
+    public static final String ENCODED_TIMESTAMP_KEY = "timestamp%3D";
+    public static final String ENCODED_PID_KEY = "pid%3D";
+    public static final String ENCODED_AND_MARK = "%26";
+    private static final char BLANK_CHAR = 0x20;
+
+    private static final ThreadLocal<TempBuffer> THREAD_LOCAL_TEMP_BUFFER = ThreadLocal.withInitial(() -> new TempBuffer(1024));
+
+    private URLStringParser() {
+        //empty
+    }
+
+
+    /**
+     * @param decodedUrlString : after {@link URL#decode} string
+     *                      decodedURLStr format: protocol://username:password@host:port/path?k1=v1&k2=v2
+     *                      [protocol://][username:password@][host:port]/[path][?k1=v1&k2=v2]
+     */
+    public static URL parseDecodedString(String decodedUrlString) {
+        Map<String, String> paramMap = null;
+        int pathEndIndex = decodedUrlString.indexOf('?');
+        if (pathEndIndex >= 0) {
+            paramMap = parseDecodedParameters(decodedUrlString, pathEndIndex + 1);
+        } else {
+            pathEndIndex = decodedUrlString.length();
+        }
+
+        String decodedContent = decodedUrlString.substring(0, pathEndIndex);
+        return parseUrlBody(decodedUrlString, decodedContent, paramMap);
+    }
+
+    private static Map<String, String> parseDecodedParameters(String input, int startIndex) {
+        int length = input.length();
+        if (startIndex >= length) {
+            return Collections.emptyMap();
+        }
+
+        TempBuffer buffer = THREAD_LOCAL_TEMP_BUFFER.get();
+        Map<String, String> paramMap = new HashMap<>();
+        int nameStartIndex = startIndex;
+        int valueStartIndex = -1;
+        int idx;
+        for (idx = startIndex; idx < length; idx++) {
+            char currentChar = input.charAt(idx);
+            switch (currentChar) {
+                case '=':
+                    if (nameStartIndex == idx) {
+                        nameStartIndex = idx + 1;
+                    } else if (valueStartIndex < nameStartIndex) {
+                        valueStartIndex = idx + 1;
+                    }
+                    break;
+                case ';':
+                case '&':
+                    addParameter(input, false, nameStartIndex, valueStartIndex, idx, paramMap, buffer);
+                    nameStartIndex = idx + 1;
+                    break;
+                default:
+                    // continue
+            }
+        }
+        addParameter(input, false, nameStartIndex, valueStartIndex, idx, paramMap, buffer);
+        return paramMap;
+    }
+
+    /**
+     * @param fullUrlString  : fullURLString
+     * @param decodedContent : format: [protocol://][username:password@][host:port]/[path]
+     * @param paramMap  :
+     * @return URL
+     */
+    private static URL parseUrlBody(String fullUrlString, String decodedContent, Map<String, String> paramMap) {
+        int starIndex = 0, endIndex = decodedContent.length();
+        // ignore the url content following '#'
+        int hashIndex = decodedContent.indexOf('#');
+        if (hashIndex != -1) {
+            endIndex = hashIndex;
+        }
+
+        String scheme = null;
+        int protoEndIndex = decodedContent.indexOf("://");
+        if (protoEndIndex >= 0) {
+            if (protoEndIndex == 0) {
+                throw new IllegalStateException("url missing protocol: \"" + fullUrlString + "\"");
+            }
+            scheme = decodedContent.substring(0, protoEndIndex);
+            starIndex = protoEndIndex + 3;
+        } else {
+            // case: file:/path/to/file.txt
+            protoEndIndex = decodedContent.indexOf(":/");
+            if (protoEndIndex >= 0) {
+                if (protoEndIndex == 0) {
+                    throw new IllegalStateException("url missing protocol: \"" + fullUrlString + "\"");
+                }
+                scheme = decodedContent.substring(0, protoEndIndex);
+                starIndex = protoEndIndex + 1;
+            }
+        }
+
+        String urlPath = null;
+        int pathStartIndex = indexOfChar(decodedContent, '/', starIndex, endIndex);
+        if (pathStartIndex >= 0) {
+            urlPath = decodedContent.substring(pathStartIndex + 1, endIndex);
+            endIndex = pathStartIndex;
+        }
+
+        String userName = null;
+        String userPassword = null;
+        int passwordEndIndex = lastIndexOfCharInRange(decodedContent, '@', starIndex, endIndex);
+        if (passwordEndIndex > 0) {
+            int passwordStartIndex = indexOfChar(decodedContent, ':', starIndex, passwordEndIndex);
+            if (passwordStartIndex != -1) {//tolerate incomplete user pwd input, like '1234@'
+                userName = decodedContent.substring(starIndex, passwordStartIndex);
+                userPassword = decodedContent.substring(passwordStartIndex + 1, passwordEndIndex);
+            } else {
+                userName = decodedContent.substring(starIndex, passwordEndIndex);
+            }
+            starIndex = passwordEndIndex + 1;
+        }
+
+        String hostname = null;
+        int portNumber = 0;
+        int hostEndIndex = lastIndexOfCharInRange(decodedContent, ':', starIndex, endIndex);
+        if (hostEndIndex > 0 && hostEndIndex < decodedContent.length() - 1) {
+            if (lastIndexOfCharInRange(decodedContent, '%', starIndex, endIndex) > hostEndIndex) {
+                // ipv6 address with scope id
+                // e.g. fe80:0:0:0:894:aeec:f37d:23e1%en0
+                // see https://howdoesinternetwork.com/2013/ipv6-zone-id
+                // ignore
+            } else {
+                portNumber = Integer.parseInt(decodedContent.substring(hostEndIndex + 1, endIndex));
+                endIndex = hostEndIndex;
+            }
+        }
+
+        if (endIndex > starIndex) {
+            hostname = decodedContent.substring(starIndex, endIndex);
+        }
+
+        // check cache
+        scheme = URLItemCache.intern(scheme);
+        urlPath = URLItemCache.checkPath(urlPath);
+
+        return new ServiceConfigURL(scheme, userName, userPassword, hostname, portNumber, urlPath, paramMap);
+    }
