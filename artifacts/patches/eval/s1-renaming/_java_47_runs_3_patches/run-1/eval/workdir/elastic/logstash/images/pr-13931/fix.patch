diff --git a/logstash-core/src/main/java/org/logstash/util/ExponentialBackoffStrategy.java b/logstash-core/src/main/java/org/logstash/util/ExponentialBackoffStrategy.java
new file mode 100644
index 000000000..cfdb32046
--- /dev/null
+++ b/logstash-core/src/main/java/org/logstash/util/ExponentialBackoffStrategy.java
@@ -0,0 +1,65 @@
+package org.logstash.util;
+
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+import java.util.Random;
+
+public class ExponentialBackoffStrategy {
+    private final long retryLimit;
+    private static final int[] RETRY_SCHEDULE_MS = {100, 200, 400, 800, 1_600, 3_200, 6_400, 12_800, 25_600, 51_200};
+    private static final int MAX_DELAY_MS = 60_000;
+
+    private static final Logger LOG = LogManager.getLogger(ExponentialBackoffStrategy.class);
+
+    public ExponentialBackoffStrategy(long retryLimit) {
+        this.retryLimit = retryLimit;
+    }
+
+    public <T> T executeWithRetry(ThrowingSupplier<T> operation) throws RetryableException {
+        long tryCount = 0L;
+
+        do {
+            try {
+                tryCount++;
+                return operation.get();
+            } catch (Exception thrownException) {
+                LOG.error("Backoff retry exception", thrownException);
+            }
+
+            if (shouldRetry(tryCount)) {
+                try {
+                    int millis = getBackoffDelay(tryCount);
+                    LOG.info("Retry({}) will execute in {} second", tryCount, millis /1000.0);
+                    Thread.sleep(millis);
+                } catch (InterruptedException interruptedException) {
+                    throw new RetryableException("Backoff retry aborted", interruptedException);
+                }
+            }
+        } while (shouldRetry(tryCount));
+
+        throw new RetryableException("Reach max retry");
+    }
+
+    private int getBackoffDelay(Long tryCount) {
+        return (tryCount - 1 < RETRY_SCHEDULE_MS.length)?
+                RETRY_SCHEDULE_MS[tryCount.intValue() - 1] + new Random().nextInt(1000) :
+                MAX_DELAY_MS;
+    }
+
+    private boolean shouldRetry(long tryCount) {
+        return tryCount <= retryLimit;
+    }
+
+    public static class RetryableException extends Exception {
+        private static final long CLASS_SERIAL_UID = 1L;
+
+        public RetryableException(String msg) {
+            super(msg);
+        }
+
+        public RetryableException(String msg, Throwable rootThrowable) {
+            super(msg, rootThrowable);
+        }
+    }
+}
