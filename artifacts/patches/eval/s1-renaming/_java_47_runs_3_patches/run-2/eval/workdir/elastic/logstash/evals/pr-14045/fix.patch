+package org.logstash.secret.password;
+
+import java.util.Optional;
+
+/**
+ * A validator which check if given password appropriates digit regex.
+ */
+public class DigitRegexValidator implements ValidityChecker {
+
+    /**
+     A regex for digit number inclusion.
+     */
+    private static final String NUMERIC_PATTERN = ".*\\d.*";
+
+    /**
+     A policy failure reasoning if password does not contain digit number(s).
+     */
+    private static final String NUMERIC_VALIDATION_NOTE = "must contain at least one digit between 0 and 9";
+
+    @Override
+    public Optional<String> checkValidity(String secretText) {
+        return secretText.matches(NUMERIC_PATTERN)
+                ? Optional.empty()
+                : Optional.of(NUMERIC_VALIDATION_NOTE);
+    }
+}
