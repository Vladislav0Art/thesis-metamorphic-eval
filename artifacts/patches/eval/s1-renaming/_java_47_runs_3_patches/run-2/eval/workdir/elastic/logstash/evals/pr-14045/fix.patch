+package org.logstash.secret.password;
+
+import com.google.common.base.Strings;
+
+import java.util.Optional;
+
+/**
+ * A validator which check if given password appropriates length policy.
+ */
+public class LengthRangeValidator implements ValidityChecker {
+
+    /**
+     Required minimum length of the password.
+     */
+    private static final int MIN_LENGTH = 5;
+
+    /**
+     Required maximum length of the password.
+     */
+    private static final int MAX_LENGTH = 1024;
+
+    /**
+     A policy failure reasoning for password length.
+     */
+    private static final String LENGTH_EXPLANATION = "must be length of between " + MIN_LENGTH + " and " + MAX_LENGTH;
+
+    /**
+     Required minimum length of the password.
+     */
+    private int minLength;
+
+    public LengthRangeValidator(int minLength) {
+        if (minLength < MIN_LENGTH || minLength > MAX_LENGTH) {
+            throw new IllegalArgumentException("Password length should be between " + MIN_LENGTH + " and " + MAX_LENGTH + ".");
+        }
+        this.minLength = minLength;
+    }
+
+    @Override
+    public Optional<String> checkValidity(String passphrase) {
+        return Strings.isNullOrEmpty(passphrase) || passphrase.length() < minLength
+                ? Optional.of(LENGTH_EXPLANATION)
+                : Optional.empty();
+    }
+}
