+package org.logstash.secret.password;
+
+import com.google.common.base.Strings;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Objects;
+import java.util.function.Function;
+
+/**
+ * Converter class for password params.
+ */
+public class PasswordParameterConverter {
+
+    @SuppressWarnings("rawtypes")
+    private static final Map<Class, Function<String, ?>> TYPE_PARSERS = new HashMap<>();
+
+    static {
+        TYPE_PARSERS.put(Integer.class, Integer::parseInt);
+        TYPE_PARSERS.put(String.class, String::toString);
+        TYPE_PARSERS.put(Boolean.class, Boolean::parseBoolean);
+        TYPE_PARSERS.put(Double.class, Double::parseDouble);
+    }
+
+    /**
+     * Converts given value to expected klass.
+     * @param targetClass a class type of the desired output value.
+     * @param inputString a value to be converted.
+     * @param <T> desired type.
+     * @return converted value.
+     * throws {@link IllegalArgumentException} if klass is not supported or value is empty.
+     */
+    @SuppressWarnings("unchecked")
+    public static <T> T convertValue(Class<T> targetClass, String inputString) {
+        if (Strings.isNullOrEmpty(inputString)) {
+            throw new IllegalArgumentException("Value must not be empty.");
+        }
+
+        if (Objects.isNull(TYPE_PARSERS.get(targetClass))) {
+            throw new IllegalArgumentException("No conversion supported for given class.");
+        }
+        return (T) TYPE_PARSERS.get(targetClass).apply(inputString);
+    }
+}
