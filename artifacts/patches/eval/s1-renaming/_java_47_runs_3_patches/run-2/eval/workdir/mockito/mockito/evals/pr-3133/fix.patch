diff --git a/subprojects/junit-jupiter/src/main/java/org/mockito/junit/jupiter/resolver/DelegatingParameterResolver.java b/subprojects/junit-jupiter/src/main/java/org/mockito/junit/jupiter/resolver/DelegatingParameterResolver.java
