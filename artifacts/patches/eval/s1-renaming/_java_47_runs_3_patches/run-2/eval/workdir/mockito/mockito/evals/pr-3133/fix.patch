+
+    public static Object createArgumentCaptorForParameter(Parameter argument) {
+        Class<?> targetClass = argument.getType();
+        if (!ArgumentCaptor.class.isAssignableFrom(targetClass)) {
+            throw new MockitoException(
+                    "@Captor field must be of the type ArgumentCaptor.\n"
+                            + "Field: '"
+                            + argument.getName()
+                            + "' has wrong type\n"
+                            + "For info how to use @Captor annotations see examples in javadoc for MockitoAnnotations class.");
+        }
+        Class<?> resolvedClass = new GenericTypeManager().getGenericType(argument);
+        return ArgumentCaptor.forClass(resolvedClass);
+    }
 }
