@@ -0,0 +1,43 @@
+/*
+ * Copyright (c) 2018 Mockito contributors
+ * This program is made available under the terms of the MIT License.
+ */
+package org.mockito.junit.jupiter.resolver;
+
+import org.junit.jupiter.api.extension.ExtensionContext;
+import org.junit.jupiter.api.extension.ParameterContext;
+import org.junit.jupiter.api.extension.ParameterResolutionException;
+import org.junit.jupiter.api.extension.ParameterResolver;
+
+import java.util.List;
+import java.util.Optional;
+
+public class DelegatingParameterResolver implements ParameterResolver {
+
+    private final List<ParameterResolver> parameterResolvers;
+
+    public DelegatingParameterResolver(final ParameterResolver... parameterResolvers) {
+        this.parameterResolvers = List.of(parameterResolvers);
+    }
+
+    @Override
+    public boolean supportsParameter(ParameterContext paramContext, ExtensionContext runtimeContext) throws ParameterResolutionException {
+        return findSupportingDelegate(paramContext, runtimeContext).isPresent();
+    }
+
+    @Override
+    @SuppressWarnings("OptionalGetWithoutIsPresent")
+    public Object resolveParameter(ParameterContext paramContext, ExtensionContext runtimeContext) throws ParameterResolutionException {
+        final ParameterResolver resolver = findSupportingDelegate(paramContext, runtimeContext).get();
+        return resolver.resolveParameter(paramContext, runtimeContext);
+    }
+
+    private Optional<ParameterResolver> findSupportingDelegate(
+        final ParameterContext paramContext,
+        final ExtensionContext runtimeContext
+    ) {
+        return parameterResolvers.stream()
+            .filter(resolver -> resolver.supportsParameter(paramContext, runtimeContext))
+            .findFirst();
+    }
+}
diff --git a/subprojects/junit-jupiter/src/main/java/org/mockito/junit/jupiter/resolver/MockArgumentResolver.java b/subprojects/junit-jupiter/src/main/java/org/mockito/junit/jupiter/resolver/MockArgumentResolver.java
