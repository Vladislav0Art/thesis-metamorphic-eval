@@ -0,0 +1,25 @@
+/*
+ * Copyright (c) 2018 Mockito contributors
+ * This program is made available under the terms of the MIT License.
+ */
+package org.mockito.junit.jupiter.resolver;
+
+import org.junit.jupiter.api.extension.ExtensionContext;
+import org.junit.jupiter.api.extension.ParameterContext;
+import org.junit.jupiter.api.extension.ParameterResolutionException;
+import org.junit.jupiter.api.extension.ParameterResolver;
+import org.mockito.Capturer;
+import org.mockito.internal.configuration.CaptorProcessor;
+
+public class ParameterCaptorResolver implements ParameterResolver {
+
+    @Override
+    public boolean supportsParameter(ParameterContext paramDescriptor, ExtensionContext extensionCtx) throws ParameterResolutionException {
+        return paramDescriptor.isAnnotated(Capturer.class);
+    }
+
+    @Override
+    public Object resolveParameter(ParameterContext paramDescriptor, ExtensionContext extensionCtx) throws ParameterResolutionException {
+        return CaptorProcessor.createArgumentCaptorForParameter(paramDescriptor.getParameter());
+    }
+}
 
