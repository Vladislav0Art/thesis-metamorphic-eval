@@ -41,4 +41,21 @@ public interface MockitoPlugins {
      * @since 2.10.0
      */
     MockMaker getInlineMockMaker();
+
+    /**
+     * Returns a mock maker by type name or alias. The mock maker is cached and reused for subsequent calls.
+     * Unlike {@link #getInlineMockMaker()}, this method returns a cached instance.
+     *
+     * <p>Mockito ships with the following mock makers:
+     * <ul>
+     *   <li>{@code mock-maker-inline} - also available as alias {@link org.mockito.MockMakers#INLINE}</li>
+     *   <li>{@code mock-maker-subclass} - also available as alias {@link org.mockito.MockMakers#SUBCLASS}</li>
+     * </ul>
+     *
+     * @param mockMaker type name or alias of the mock maker, see {@link org.mockito.MockMakers} for available aliases.
+     *                  If {@code null}, the default mock maker is returned.
+     * @return the mock maker instance
+     * @since 5.0.0
+     */
+    MockMaker getMockMaker(String mockMaker);
 }
