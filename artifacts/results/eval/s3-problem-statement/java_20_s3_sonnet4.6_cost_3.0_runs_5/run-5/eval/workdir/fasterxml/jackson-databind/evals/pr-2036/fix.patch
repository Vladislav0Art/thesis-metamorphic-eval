@@ -474,7 +474,21 @@ public enum MapperFeature implements ConfigFeature
      *
      * @since 2.9
      */
-    IGNORE_MERGE_FOR_UNMERGEABLE(true)
+    IGNORE_MERGE_FOR_UNMERGEABLE(true),
+
+    /**
+     * Feature that determines whether the declared base type of a polymorphic value
+     * is used as the "default implementation" when no type identifier is included in
+     * the JSON (and there is no explicit {@code defaultImpl} annotation configured).
+     * This is useful when deserializing using a concrete class (as opposed to an
+     * abstract type or interface), since the concrete class itself can serve as the
+     * default implementation to use.
+     *<p>
+     * Feature is disabled by default.
+     *
+     * @since 2.10
+     */
+    USE_BASE_TYPE_AS_DEFAULT_IMPL(false)
 
     ;
 
