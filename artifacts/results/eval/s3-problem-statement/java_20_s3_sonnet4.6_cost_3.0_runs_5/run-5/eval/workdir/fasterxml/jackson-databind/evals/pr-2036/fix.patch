+++ b/src/test/java/com/fasterxml/jackson/databind/jsontype/UseBaseTypeAsDefaultImplTest.java
@@ -0,0 +1,91 @@
+package com.fasterxml.jackson.databind.jsontype;
+
+import com.fasterxml.jackson.annotation.JsonTypeInfo;
+import com.fasterxml.jackson.databind.BaseMapTest;
+import com.fasterxml.jackson.databind.MapperFeature;
+import com.fasterxml.jackson.databind.ObjectMapper;
+
+public class UseBaseTypeAsDefaultImplTest extends BaseMapTest
+{
+    @JsonTypeInfo(use = JsonTypeInfo.Id.MINIMAL_CLASS, include = JsonTypeInfo.As.PROPERTY, property = "type")
+    interface MyInterface {
+        String getName();
+        void setName(String name);
+    }
+
+    static class MyClass implements MyInterface {
+        private String name;
+        @Override
+        public String getName() { return name; }
+        @Override
+        public void setName(String name) { this.name = name; }
+    }
+
+    // Another interface using NAME-based type info
+    @JsonTypeInfo(use = JsonTypeInfo.Id.NAME, include = JsonTypeInfo.As.PROPERTY, property = "@type")
+    static abstract class AbstractBase {
+        public int value;
+    }
+
+    static class ConcreteImpl extends AbstractBase {
+    }
+
+    /*
+    /**********************************************************
+    /* Test methods
+    /**********************************************************
+     */
+
+    // Test: feature disabled (default), no type info -> should fail
+    public void testWithoutFeatureEnabled() throws Exception {
+        ObjectMapper mapper = newObjectMapper();
+        // Feature disabled by default
+        assertFalse(mapper.isEnabled(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL));
+        try {
+            mapper.readValue("{\"name\":\"test\"}", MyClass.class);
+            fail("Should have thrown an exception without type property");
+        } catch (Exception e) {
+            // expected
+        }
+    }
+
+    // Test: feature enabled, no type info, concrete class -> should succeed
+    public void testWithFeatureEnabled() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.enable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL);
+        MyClass result = mapper.readValue("{\"name\":\"test\"}", MyClass.class);
+        assertNotNull(result);
+        assertEquals("test", result.getName());
+    }
+
+    // Test: feature enabled, with type info, should still work
+    public void testWithFeatureEnabledAndTypeInfo() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.enable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL);
+        MyInterface result = mapper.readValue("{\"name\":\"test\",\"type\":\".UseBaseTypeAsDefaultImplTest$MyClass\"}", MyInterface.class);
+        assertNotNull(result);
+        assertEquals("test", result.getName());
+    }
+
+    // Test: feature enabled, abstract class -> should fail (not concrete)
+    public void testWithFeatureEnabledAbstractBase() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.enable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL);
+        // Abstract class as base type should NOT use itself as default impl
+        try {
+            mapper.readValue("{\"value\":42}", AbstractBase.class);
+            fail("Should have thrown an exception - abstract type cannot be default impl");
+        } catch (Exception e) {
+            // expected
+        }
+    }
+
+    // Test: feature enabled, concrete class as base, concrete class works
+    public void testWithFeatureEnabledConcreteSubclass() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.enable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL);
+        ConcreteImpl result = mapper.readValue("{\"value\":42}", ConcreteImpl.class);
+        assertNotNull(result);
+        assertEquals(42, result.value);
+    }
+}
