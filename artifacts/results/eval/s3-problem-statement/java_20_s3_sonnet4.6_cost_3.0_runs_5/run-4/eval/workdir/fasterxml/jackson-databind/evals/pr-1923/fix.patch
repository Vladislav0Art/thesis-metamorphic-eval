+    public void testSpringInterfaceHandling1887() throws Exception
+    {
+        // Verify that Spring interface does not cause NPE (databind#1887)
+        // BogusGrantedAuthority is in org.springframework.jacksontest package
+        // and is an interface -- previously caused NPE because getSuperclass()
+        // returns null for interfaces
+        String json = aposToQuotes("{'v':['"+BogusGrantedAuthority.class.getName()+"',{}]}");
+        try {
+            MAPPER.readValue(json, PolyWrapper.class);
+            // Fine if it succeeds (though unusual for an interface)
+        } catch (JsonMappingException e) {
+            // Acceptable: some deserialization issue, but must NOT be NPE
+            Throwable cause = e.getCause();
+            if (cause instanceof NullPointerException) {
+                fail("Should not get NullPointerException for Spring interface");
+            }
+        }
+    }
