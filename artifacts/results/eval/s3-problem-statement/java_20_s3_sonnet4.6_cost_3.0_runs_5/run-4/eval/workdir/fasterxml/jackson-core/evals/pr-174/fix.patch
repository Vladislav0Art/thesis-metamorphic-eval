diff --git a/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java b/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java
index 9ef13aa7..c47eb7a7 100644
--- a/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java
+++ b/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java
@@ -102,4 +102,29 @@ public class TestJsonPointer extends BaseTest
         assertTrue(ptr.matches());
         assertNull(ptr.tail());
     }
+    public void testLast() throws Exception
+    {
+        // Test with a simple path
+        JsonPointer ptr = JsonPointer.compile("/Image/15/name");
+        JsonPointer last = ptr.last();
+        assertNotNull(last);
+        assertEquals("/name", last.toString());
+        assertEquals("name", last.getMatchingProperty());
+
+        // Test with single segment
+        JsonPointer single = JsonPointer.compile("/score");
+        JsonPointer lastSingle = single.last();
+        assertNotNull(lastSingle);
+        assertEquals("/score", lastSingle.toString());
+
+        // Test with array append notation (JSON Patch use case)
+        JsonPointer arrayAppend = JsonPointer.compile("/score/-");
+        JsonPointer lastArrayAppend = arrayAppend.last();
+        assertNotNull(lastArrayAppend);
+        assertEquals("/-", lastArrayAppend.toString());
+
+        // Test with empty pointer (matches root)
+        JsonPointer empty = JsonPointer.compile("");
+        assertNull(empty.last());
+    }
 }
