diff --git a/src/main/java/com/fasterxml/jackson/core/JsonPointer.java b/src/main/java/com/fasterxml/jackson/core/JsonPointer.java
index ff251034..3de7bbfb 100644
--- a/src/main/java/com/fasterxml/jackson/core/JsonPointer.java
+++ b/src/main/java/com/fasterxml/jackson/core/JsonPointer.java
@@ -194,6 +194,27 @@ public class JsonPointer
         return _headSegment;
     }
 
+    /**
+     * Accessor for getting the last segment of this pointer, i.e., the "leaf" segment.
+     * This is useful for JSON Patch operations that need to identify the terminal segment.
+     * For example, for pointer "/score/-", this method would return the JsonPointer for "/-".
+     *
+     * @return The last segment of this pointer, or {@code null} if this pointer is empty (matches current node).
+     *
+     * @since 2.5
+     */
+    public JsonPointer last() {
+        JsonPointer current = this;
+        if (current.matches()) {
+            return null;
+        }
+        JsonPointer next;
+        while ((next = current._nextSegment) != null && !next.matches()) {
+            current = next;
+        }
+        return current;
+    }
+
