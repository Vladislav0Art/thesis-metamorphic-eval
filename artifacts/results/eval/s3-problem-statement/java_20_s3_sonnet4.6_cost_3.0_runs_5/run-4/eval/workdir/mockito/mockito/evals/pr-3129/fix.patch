diff --git a/src/main/java/org/mockito/plugins/MockitoPlugins.java b/src/main/java/org/mockito/plugins/MockitoPlugins.java
index d911077fd..0b6962395 100644
--- a/src/main/java/org/mockito/plugins/MockitoPlugins.java
+++ b/src/main/java/org/mockito/plugins/MockitoPlugins.java
@@ -41,4 +41,19 @@ public interface MockitoPlugins {
      * @since 2.10.0
      */
     MockMaker getInlineMockMaker();
+
+    /**
+     * Returns a mock maker by its type name or alias.
+     * Unlike {@link #getInlineMockMaker()}, this method caches instances, so multiple calls
+     * with the same argument return the same instance. This is useful for framework integrations
+     * that want to use the same mock maker instance as Mockito internally uses.
+     * <p>
+     * Valid aliases can be found in {@link org.mockito.MockMakers}.
+     *
+     * @param mockMaker the fully qualified class name of the mock maker, or an alias defined in
+     *                  {@link org.mockito.MockMakers}; {@code null} returns the default mock maker
+     * @return the mock maker instance
+     * @since 5.0.0
+     */
+    MockMaker getMockMaker(String mockMaker);
 }
