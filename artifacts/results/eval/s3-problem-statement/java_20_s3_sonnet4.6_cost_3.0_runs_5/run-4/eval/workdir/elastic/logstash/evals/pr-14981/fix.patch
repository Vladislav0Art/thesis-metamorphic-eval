+    public void testWriterCanInitializeWithOneByteSegmentFile() throws IOException {
+        // Create a 1-byte segment file (only the version byte) to simulate the case
+        // where the DLQ was initialized but no events were written
+        Path segmentFile = dir.resolve("1.log");
+        Files.write(segmentFile, new byte[]{1}); // VERSION_SIZE = 1 byte
+
+        // The writer should be able to initialize without throwing IllegalArgumentException
+        try (DeadLetterQueueWriter writer = DeadLetterQueueWriter
+                .newBuilder(dir, 1_000, 100_000, Duration.ofSeconds(1))
+                .build()) {
+            // Write an entry to verify the writer works correctly
+            DLQEntry entry = new DLQEntry(new Event(), "type", "id", "reason");
+            writer.writeEntry(entry);
+        }
