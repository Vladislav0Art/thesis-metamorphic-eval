      */
     MockMaker getInlineMockMaker();
+
+    /**
+     * Returns the mock maker implementation of the given type or alias.
+     * Unlike {@link #getInlineMockMaker()}, this method returns a shared, cached instance,
+     * so that the same mock maker instance is reused across Mockito and framework integrations.
+     * <p>
+     * Valid arguments are:
+     * <ul>
+     *     <li>A fully qualified class name of a {@link MockMaker} implementation</li>
+     *     <li>An alias such as {@code "mock-maker-inline"}, {@code "mock-maker-proxy"}, or {@code "mock-maker-subclass"}</li>
+     * </ul>
+     *
+     * @param mockMaker the class name or alias of the mock maker to retrieve
+     * @return the shared mock maker instance
+     * @since 5.x.x
+     */
+    MockMaker getMockMaker(String mockMaker);
 }
