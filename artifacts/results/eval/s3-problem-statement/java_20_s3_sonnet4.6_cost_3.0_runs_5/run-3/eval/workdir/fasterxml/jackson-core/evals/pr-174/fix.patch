diff --git a/src/main/java/com/fasterxml/jackson/core/JsonPointer.java b/src/main/java/com/fasterxml/jackson/core/JsonPointer.java
index ff251034..523dae9e 100644
--- a/src/main/java/com/fasterxml/jackson/core/JsonPointer.java
+++ b/src/main/java/com/fasterxml/jackson/core/JsonPointer.java
@@ -194,6 +194,26 @@ public class JsonPointer
         return _headSegment;
     }
 
+    /**
+     * Accessor for getting the last segment of this pointer instance, if any.
+     * For example, for pointer "/a/b/c" it would return the pointer representing "/c".
+     * For pointer "/score/-" it would return the pointer representing "/-".
+     * For an empty pointer (representing the root path), will return null.
+     *
+     * @since 2.5
+     */
+    public JsonPointer last() {
+        JsonPointer current = this;
+        if (current == EMPTY) {
+            return null;
+        }
+        JsonPointer next;
+        while ((next = current._nextSegment) != EMPTY) {
+            current = next;
+        }
+        return current;
+    }
+
