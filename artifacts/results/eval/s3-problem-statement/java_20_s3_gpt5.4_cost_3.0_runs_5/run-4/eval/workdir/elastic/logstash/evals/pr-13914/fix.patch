diff --git a/build.gradle b/build.gradle
index 7e4c7a868..43418b4c3 100644
--- a/build.gradle
+++ b/build.gradle
@@ -860,6 +860,21 @@ tasks.register("copyJdk", Copy) {
     description = "Download, unpack and copy the JDK"
     // CLI project properties: -Pjdk_bundle_os=[windows|linux|darwin] -Pjdk_arch=[arm64|x86_64]
     doLast {
+        File jdkHome = file(project.ext.jdkBundlingDirectory)
+        File releaseFile = file("${jdkHome}/release")
+        if (!releaseFile.exists()) {
+            jdkHome = file("${project.ext.jdkBundlingDirectory}/Contents/Home")
+            releaseFile = file("${jdkHome}/release")
+        }
+        if (releaseFile.exists()) {
+            String implementorVersion = releaseFile.readLines()
+                .find { it.startsWith("IMPLEMENTOR_VERSION=") }
+                ?.replace('IMPLEMENTOR_VERSION="', '')
+                ?.replace('"', '')
+            if (implementorVersion != null && !implementorVersion.isEmpty()) {
+                file("${jdkHome}/VERSION").text = "${implementorVersion}\n"
+            }
+        }
         System.out.println "Download location is ${project.ext.jdkDownloadLocation}, Decompressing ${project.ext.jdkDirectory} to \"${project.ext.jdkBundlingDirectory}\""
     }
 }
