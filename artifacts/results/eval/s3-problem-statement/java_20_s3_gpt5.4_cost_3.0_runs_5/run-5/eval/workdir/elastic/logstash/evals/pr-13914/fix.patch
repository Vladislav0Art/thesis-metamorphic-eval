diff --git a/build.gradle b/build.gradle
index 7e4c7a868..6f3974968 100644
--- a/build.gradle
+++ b/build.gradle
@@ -860,6 +860,21 @@ tasks.register("copyJdk", Copy) {
     description = "Download, unpack and copy the JDK"
     // CLI project properties: -Pjdk_bundle_os=[windows|linux|darwin] -Pjdk_arch=[arm64|x86_64]
     doLast {
+        String osName = selectOsType()
+        File jdkBundlingDirectory = new File(project.ext.jdkBundlingDirectory)
+        File releaseFile = osName == "darwin" ?
+            new File(jdkBundlingDirectory, "Contents/Home/release") :
+            new File(jdkBundlingDirectory, "release")
+        if (!releaseFile.exists()) {
+            throw new GradleException("Unable to locate bundled JDK release file at ${releaseFile}")
+        }
+
+        def matcher = (releaseFile.text =~ /(?m)^IMPLEMENTOR_VERSION="([^"]+)"$/)
+        if (!matcher.find()) {
+            throw new GradleException("Unable to determine bundled JDK version from ${releaseFile}")
+        }
+
+        new File(jdkBundlingDirectory, "VERSION").text = matcher.group(1) + System.lineSeparator()
         System.out.println "Download location is ${project.ext.jdkDownloadLocation}, Decompressing ${project.ext.jdkDirectory} to \"${project.ext.jdkBundlingDirectory}\""
     }
 }
