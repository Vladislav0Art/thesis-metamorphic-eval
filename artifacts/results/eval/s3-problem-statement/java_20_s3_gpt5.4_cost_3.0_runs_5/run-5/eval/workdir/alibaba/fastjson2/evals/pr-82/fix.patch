+    @Test
+    public void test_isValidObject_0() {
+        assertTrue(JSON.isValidObject("{}"));
+        assertTrue(JSON.isValidObject("{\"id\":123}"));
+        assertFalse(JSON.isValidObject("[]"));
+        assertFalse(JSON.isValidObject("123"));
+
+        byte[] objectBytes = "{\"id\":123}".getBytes(StandardCharsets.UTF_8);
+        byte[] arrayBytes = "[]".getBytes(StandardCharsets.UTF_8);
+        assertTrue(JSON.isValidObject(objectBytes));
+        assertTrue(JSON.isValidObject(objectBytes, 0, objectBytes.length, StandardCharsets.UTF_8));
+        assertFalse(JSON.isValidObject(arrayBytes));
+        assertFalse(JSON.isValidObject(arrayBytes, 0, arrayBytes.length, StandardCharsets.UTF_8));
+    }
