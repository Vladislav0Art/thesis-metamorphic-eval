+    @Test
+    void testExplicitEmptyQueryParamValue() {
+        URL decoded = URLStrParser.parseDecodedStr("nacos://10.20.0.100:8848?username=&password=&namespace=");
+        Assertions.assertEquals("", decoded.getParameter("username"));
+        Assertions.assertEquals("", decoded.getParameter("password"));
+        Assertions.assertEquals("", decoded.getParameter("namespace"));
+
+        URL encoded = URLStrParser.parseEncodedStr(
+                URL.encode("nacos://10.20.0.100:8848?username=&password=&namespace="));
+        Assertions.assertEquals("", encoded.getParameter("username"));
+        Assertions.assertEquals("", encoded.getParameter("password"));
+        Assertions.assertEquals("", encoded.getParameter("namespace"));
+
+        URL noValue = URLStrParser.parseDecodedStr("dubbo://127.0.0.1?noValue");
+        Assertions.assertEquals("noValue", noValue.getParameter("noValue"));
+    }
+}
