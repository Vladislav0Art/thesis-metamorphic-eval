diff --git a/logstash-core/spec/logstash/util/buftok_spec.rb b/logstash-core/spec/logstash/util/buftok_spec.rb
index cccb9c476..5d7093e13 100644
--- a/logstash-core/spec/logstash/util/buftok_spec.rb
+++ b/logstash-core/spec/logstash/util/buftok_spec.rb
@@ -57,4 +57,26 @@ describe  FileWatch::BufferedTokenizer  do
       expect(subject.extract("foo||bar")).to eq(["foo"])
     end
   end
+
+  context 'with size limit' do
+    let(:delimiter) { "\n" }
+    subject { FileWatch::BufferedTokenizer.new(delimiter, 10) }
+
+    it "discards buffered input after buffer full so processing can restart at the next token" do
+      expect(subject.extract("123456789")).to eq([])
+
+      expect { subject.extract("01\nbar\n") }.to raise_error(IllegalStateException, "input buffer full")
+
+      expect(subject.extract("bar\n")).to eq(["bar"])
+    end
+
+    it "continues discarding input until the next delimiter after buffer full" do
+      expect(subject.extract("123456789")).to eq([])
+
+      expect { subject.extract("01") }.to raise_error(IllegalStateException, "input buffer full")
+
+      expect(subject.extract("23")).to eq([])
+      expect(subject.extract("4\nbar\n")).to eq(["bar"])
+    end
+  end
 end
