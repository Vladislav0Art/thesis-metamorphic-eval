+    @Test
+    public void pipelineBusV2AddressStateMutationDoesNotDeadlockWithBlockingUnlistenLockOrder() throws InterruptedException {
+        if (!(bus instanceof PipelineBusV2.Testable)) {
+            return;
+        }
+
+        final PipelineBusV2.AddressStateMapping mapping = new PipelineBusV2.AddressStateMapping();
+        final TestPipelineInput listener = new TestPipelineInput();
+        final String testAddress = "deadlock-test-address";
+
+        final CountDownLatch senderMutationHoldingMapLock = new CountDownLatch(1);
+        final CountDownLatch listenerMonitorHeld = new CountDownLatch(1);
+        final CountDownLatch completed = new CountDownLatch(2);
+
+        final Thread unregisterSenderThread = new Thread(() -> {
+            try {
+                mapping.mutate(testAddress, (addressState) -> {
+                    addressState.assignInputIfMissing(listener);
+                    senderMutationHoldingMapLock.countDown();
+                    try {
+                        listenerMonitorHeld.await();
+                    } catch (InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                        throw new AssertionError(e);
+                    }
+                });
+            } finally {
+                completed.countDown();
+            }
+        }, "unregisterSenderThread");
+        unregisterSenderThread.setDaemon(true);
+
+        final Thread unlistenThread = new Thread(() -> {
+            try {
+                try {
+                    senderMutationHoldingMapLock.await();
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                    throw new AssertionError(e);
+                }
+
+                synchronized (listener) {
+                    listenerMonitorHeld.countDown();
+                    mapping.mutate(testAddress, (addressState) -> addressState.unassignInput(listener));
+                }
+            } finally {
+                completed.countDown();
+            }
+        }, "unlistenThread");
+        unlistenThread.setDaemon(true);
+
+        unregisterSenderThread.start();
+        unlistenThread.start();
+
+        assertThat(completed.await(5, TimeUnit.SECONDS)).isTrue();
+
+        unregisterSenderThread.join(Duration.ofSeconds(1).toMillis());
+        unlistenThread.join(Duration.ofSeconds(1).toMillis());
+
+        assertThat(unregisterSenderThread.getState()).isEqualTo(Thread.State.TERMINATED);
+        assertThat(unlistenThread.getState()).isEqualTo(Thread.State.TERMINATED);
+    }
 
