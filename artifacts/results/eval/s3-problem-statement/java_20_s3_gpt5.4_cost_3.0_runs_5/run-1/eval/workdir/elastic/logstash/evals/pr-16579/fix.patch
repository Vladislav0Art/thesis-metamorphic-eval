diff --git a/logstash-core/spec/logstash/util/buftok_spec.rb b/logstash-core/spec/logstash/util/buftok_spec.rb
index cccb9c476..4e0fa8fbd 100644
--- a/logstash-core/spec/logstash/util/buftok_spec.rb
+++ b/logstash-core/spec/logstash/util/buftok_spec.rb
@@ -57,4 +57,18 @@ describe  FileWatch::BufferedTokenizer  do
       expect(subject.extract("foo||bar")).to eq(["foo"])
     end
   end
+
+  context "with size limit" do
+    subject { FileWatch::BufferedTokenizer.new("\n", size_limit) }
+
+    let(:size_limit) { 10 }
+
+    it "resumes after the next delimiter when the buffer is full" do
+      expect(subject.extract("12345")).to eq([])
+
+      expect { subject.extract("67890\nabc\n") }.to raise_error(IllegalStateException, "input buffer full")
+
+      expect(subject.extract("xyz\n")).to eq(["xyz"])
+    end
+  end
 end
