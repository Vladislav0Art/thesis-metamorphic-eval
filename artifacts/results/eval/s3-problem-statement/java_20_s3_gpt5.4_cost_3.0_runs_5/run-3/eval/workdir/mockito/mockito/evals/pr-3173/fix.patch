+ * This program is made available under the terms of the MIT License.
+ */
+package org.mockitousage;
+
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.Spy;
+import org.mockito.junit.jupiter.MockitoExtension;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+
+@ExtendWith(MockitoExtension.class)
+class GenericSpyTest {
+
+    @Spy private final List<String> genericSpy = List.of("item A", "item B");
+
+    @Spy private FinalType finalType = new FinalType("some value");
+
+    @Test
+    void should_not_reset_preexisting_final_spy_when_generic_spy_is_present() {
+        assertNotNull(finalType.value());
+        assertEquals("some value", finalType.value());
+    }
+
+    static final class FinalType {
+        private final String value;
+
+        FinalType(String value) {
+            this.value = value;
+        }
+
+        String value() {
+            return value;
+        }
+    }
+}
