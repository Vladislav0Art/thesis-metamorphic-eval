+        VALUE_ONE,
+        VALUE_TWO
+    }
+
+    interface HasEnumMethod {
+        SomeEnum getEnum();
+    }
+
+    @Test
+    public void deep_stub_returns_null_for_enum_return_type() {
+        HasEnumMethod mock = mock(HasEnumMethod.class, RETURNS_DEEP_STUBS);
+        // Should not throw an exception, should return null (default for enum in deep stubs)
+        assertNull(mock.getEnum());
+    }
+
+    @Test
+    public void deep_stub_can_be_stubbed_for_enum_return_type() {
+        HasEnumMethod mock = mock(HasEnumMethod.class, RETURNS_DEEP_STUBS);
+        when(mock.getEnum()).thenReturn(SomeEnum.VALUE_ONE);
+        assertThat(mock.getEnum()).isEqualTo(SomeEnum.VALUE_ONE);
+    }
