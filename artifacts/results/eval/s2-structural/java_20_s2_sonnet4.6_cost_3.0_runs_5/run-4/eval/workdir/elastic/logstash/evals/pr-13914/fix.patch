diff --git a/build.gradle b/build.gradle
index 7e4c7a868..06460c07b 100644
--- a/build.gradle
+++ b/build.gradle
@@ -861,6 +861,23 @@ tasks.register("copyJdk", Copy) {
     // CLI project properties: -Pjdk_bundle_os=[windows|linux|darwin] -Pjdk_arch=[arm64|x86_64]
     doLast {
         System.out.println "Download location is ${project.ext.jdkDownloadLocation}, Decompressing ${project.ext.jdkDirectory} to \"${project.ext.jdkBundlingDirectory}\""
+        // Create the VERSION file with the bundled JDK version extracted from the release file
+        String osName = selectOsType()
+        String releaseFilePath = osName == "darwin" ?
+            "${project.ext.jdkBundlingDirectory}/Contents/Home/release" :
+            "${project.ext.jdkBundlingDirectory}/release"
+        String versionFilePath = osName == "darwin" ?
+            "${project.ext.jdkBundlingDirectory}/Contents/Home/VERSION" :
+            "${project.ext.jdkBundlingDirectory}/VERSION"
+        File releaseFile = new File(releaseFilePath)
+        if (releaseFile.exists()) {
+            String implementorVersion = releaseFile.readLines().find { it.startsWith("IMPLEMENTOR_VERSION") }
+            if (implementorVersion) {
+                // Extract the version string without surrounding quotes
+                String version = implementorVersion.split("=")[1].replaceAll('"', '').trim()
+                new File(versionFilePath).text = version
+            }
+        }
     }
 }
 
