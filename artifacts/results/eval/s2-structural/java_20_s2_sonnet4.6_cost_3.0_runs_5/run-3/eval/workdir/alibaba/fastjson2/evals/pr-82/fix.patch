@@ -15,4 +15,21 @@ public class JSONValidatorTest {
         assertFalse(JSON.isValid(utf8, 0, utf8.length, StandardCharsets.UTF_8));
         assertFalse(JSON.isValid(utf8, 0, utf8.length, StandardCharsets.US_ASCII));
     }
+
+    @Test
+    public void validate_test_trailing_content() {
+        // Test that trailing content after valid JSON is rejected
+        assertFalse(JSON.isValid("{}abc"));
+        assertFalse(JSON.isValid("[] abc"));
+        assertFalse(JSON.isValid("{} {}"));
+        assertFalse(JSON.isValidArray("[]abc"));
+        assertFalse(JSON.isValidArray("[] {}"));
+
+        byte[] utf8 = "{}abc".getBytes(StandardCharsets.UTF_8);
+        assertFalse(JSON.isValid(utf8));
+        assertFalse(JSON.isValid(utf8, 0, utf8.length, StandardCharsets.UTF_8));
+
+        byte[] arrBytes = "[]abc".getBytes(StandardCharsets.UTF_8);
+        assertFalse(JSON.isValidArray(arrBytes));
+    }
 }
