+    // // // Tests for [databind#1872]
+    public void testSpringInterface1872() throws Exception
+    {
+        // Spring interface types should not cause NPE in SubTypeValidator
+        ObjectMapper mapper = objectMapper();
+        mapper.enableDefaultTyping(ObjectMapper.DefaultTyping.NON_FINAL, JsonTypeInfo.As.PROPERTY);
+        // This should work without NPE since BogusGrantedAuthority is an interface
+        // starting with "org.springframework."
+        String json = aposToQuotes("{'@class':'org.springframework.jacksontest.BogusGrantedAuthority'}");
+        try {
+            mapper.readValue(json, BogusGrantedAuthority.class);
+        } catch (JsonMappingException e) {
+            // If it's a security exception or other mapped exception that's OK
+            // We just need to make sure there's no NullPointerException
+            if (e.getCause() instanceof NullPointerException) {
+                fail("Should not throw NullPointerException, but got: " + e);
+            }
+        }
+    }
