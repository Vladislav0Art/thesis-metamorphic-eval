diff --git a/src/test/java/com/fasterxml/jackson/databind/jsontype/TestPolymorphicWithDefaultImpl.java b/src/test/java/com/fasterxml/jackson/databind/jsontype/TestPolymorphicWithDefaultImpl.java
index 008dc373a..35534c937 100644
--- a/src/test/java/com/fasterxml/jackson/databind/jsontype/TestPolymorphicWithDefaultImpl.java
+++ b/src/test/java/com/fasterxml/jackson/databind/jsontype/TestPolymorphicWithDefaultImpl.java
@@ -279,6 +279,24 @@ public class TestPolymorphicWithDefaultImpl extends BaseMapTest
         AsPropertyWrapper wrapper = r.readValue("{ \"value\": \"\" }");
         assertNull(wrapper.value);
     }
+    // [databind#1629]
+    public void testUseBaseTypeAsDefaultImpl() throws Exception
+    {
+        // without the feature, should fail
+        try {
+            MAPPER.readValue("{}", AsProperty.class);
+            fail("Should fail without type id");
+        } catch (JsonMappingException e) {
+            verifyException(e, "missing type id property 'type'");
+        }
+
+        // but with the feature enabled, should work with base type as default
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.enable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL);
+        AsProperty value = mapper.readValue("{}", AsProperty.class);
+        assertNotNull(value);
+        assertEquals(AsProperty.class, value.getClass());
+    }
 
