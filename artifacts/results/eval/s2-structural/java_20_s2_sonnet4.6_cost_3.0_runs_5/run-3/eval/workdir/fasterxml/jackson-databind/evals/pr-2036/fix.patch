+    IGNORE_MERGE_FOR_UNMERGEABLE(true),
+
+    /**
+     * Feature that determines whether the declared base type of a polymorphic
+     * value is to be used as the "default implementation" (<code>defaultImpl</code>)
+     * if no type id is available for an entry. Note that if this feature is enabled,
+     * it has lower precedence than <code>defaultImpl</code> set via
+     * {@link com.fasterxml.jackson.annotation.JsonTypeInfo#defaultImpl()}.
+     *<p>
+     * Feature is disabled by default for backwards compatibility reasons.
+     *
+     * @since 2.10
+     */
+    USE_BASE_TYPE_AS_DEFAULT_IMPL(false)
 
