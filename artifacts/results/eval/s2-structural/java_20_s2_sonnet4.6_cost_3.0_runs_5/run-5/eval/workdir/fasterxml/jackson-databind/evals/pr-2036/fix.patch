diff --git a/src/test/java/com/fasterxml/jackson/databind/jsontype/UseBaseTypeAsDefaultImplTest.java b/src/test/java/com/fasterxml/jackson/databind/jsontype/UseBaseTypeAsDefaultImplTest.java
new file mode 100644
index 000000000..0e602862d
--- /dev/null
+++ b/src/test/java/com/fasterxml/jackson/databind/jsontype/UseBaseTypeAsDefaultImplTest.java
@@ -0,0 +1,58 @@
+package com.fasterxml.jackson.databind.jsontype;
+
+import com.fasterxml.jackson.annotation.JsonTypeInfo;
+import com.fasterxml.jackson.databind.BaseMapTest;
+import com.fasterxml.jackson.databind.MapperFeature;
+import com.fasterxml.jackson.databind.ObjectMapper;
+
+public class UseBaseTypeAsDefaultImplTest extends BaseMapTest
+{
+    @JsonTypeInfo(use = JsonTypeInfo.Id.MINIMAL_CLASS,
+            include = JsonTypeInfo.As.PROPERTY,
+            property = "type")
+    interface MyInterface {
+        String getName();
+        void setName(String name);
+    }
+
+    static class MyClass implements MyInterface {
+        private String name;
+
+        @Override
+        public String getName() { return name; }
+
+        @Override
+        public void setName(String name) { this.name = name; }
+    }
+
+    // Feature is disabled by default; reading without type info should fail
+    public void testFeatureDisabled() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        try {
+            mapper.readValue("{\"name\":\"test\"}", MyClass.class);
+            fail("Should have thrown exception");
+        } catch (Exception e) {
+            // expected
+        }
+    }
+
+    // Feature enabled: reading without type info should use base type as default impl
+    public void testFeatureEnabled() throws Exception {
+        ObjectMapper mapper = new ObjectMapper()
+                .enable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL);
+        MyClass result = mapper.readValue("{\"name\":\"test\"}", MyClass.class);
+        assertNotNull(result);
+        assertEquals("test", result.getName());
+    }
+
+    // Make sure the normal case (with type info) still works
+    public void testWithTypeInfo() throws Exception {
+        ObjectMapper mapper = new ObjectMapper()
+                .enable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL);
+        MyInterface result = mapper.readValue(
+                "{\"type\":\".UseBaseTypeAsDefaultImplTest$MyClass\",\"name\":\"name\"}",
+                MyInterface.class);
+        assertNotNull(result);
+        assertEquals("name", result.getName());
+    }
+}
