      */
-    IGNORE_MERGE_FOR_UNMERGEABLE(true)
+    IGNORE_MERGE_FOR_UNMERGEABLE(true),
+
+    /**
+     * Feature that determines whether the declared base type is used as the
+     * default implementation for polymorphic type handling, when no explicit
+     * default implementation ({@code @JsonTypeInfo#defaultImpl}) is defined.
+     *<p>
+     * This is useful when deserializing JSON without a type identifier into a
+     * concrete class that has {@link com.fasterxml.jackson.annotation.JsonTypeInfo}
+     * annotation (typically from an interface or base class).
+     * With this feature enabled, Jackson will use the requested deserialization
+     * type (the concrete class) as the default implementation if no type id is
+     * present in the input.
+     *<p>
+     * Feature is disabled by default (to preserve backwards-compatible behavior).
+     *
+     * @since 2.10
+     */
+    USE_BASE_TYPE_AS_DEFAULT_IMPL(false)
 
     ;
 
