diff --git a/src/test/java/com/fasterxml/jackson/databind/jsontype/UseBaseTypeAsDefaultImplTest.java b/src/test/java/com/fasterxml/jackson/databind/jsontype/UseBaseTypeAsDefaultImplTest.java
new file mode 100644
index 000000000..1e4fe58a4
--- /dev/null
+++ b/src/test/java/com/fasterxml/jackson/databind/jsontype/UseBaseTypeAsDefaultImplTest.java
@@ -0,0 +1,91 @@
+package com.fasterxml.jackson.databind.jsontype;
+
+import com.fasterxml.jackson.annotation.JsonTypeInfo;
+import com.fasterxml.jackson.databind.BaseMapTest;
+import com.fasterxml.jackson.databind.MapperFeature;
+import com.fasterxml.jackson.databind.ObjectMapper;
+
+/**
+ * Tests for [databind#2197]: MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL
+ */
+public class UseBaseTypeAsDefaultImplTest extends BaseMapTest
+{
+    @JsonTypeInfo(use = JsonTypeInfo.Id.NAME, property = "type")
+    interface MyInterface {
+        String getName();
+    }
+
+    static class MyImpl implements MyInterface {
+        private String name;
+
+        public MyImpl() { }
+        public MyImpl(String name) { this.name = name; }
+
+        @Override
+        public String getName() { return name; }
+        public void setName(String name) { this.name = name; }
+    }
+
+    @JsonTypeInfo(use = JsonTypeInfo.Id.MINIMAL_CLASS, include = JsonTypeInfo.As.PROPERTY, property = "type")
+    interface MyInterface2 {
+        String getName();
+    }
+
+    static class MyImpl2 implements MyInterface2 {
+        private String name;
+
+        public MyImpl2() { }
+        public MyImpl2(String name) { this.name = name; }
+
+        @Override
+        public String getName() { return name; }
+        public void setName(String name) { this.name = name; }
+    }
+
+    // Test that deserialization of a concrete class (no type id in JSON)
+    // works when USE_BASE_TYPE_AS_DEFAULT_IMPL is enabled
+    public void testDeserializeConcreteClassWithoutTypeId() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.enable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL);
+        String json = "{\"name\":\"test\"}";
+        MyImpl result = mapper.readValue(json, MyImpl.class);
+        assertNotNull(result);
+        assertEquals("test", result.getName());
+    }
+
+    // Test that deserialization still fails (as expected) when feature is disabled
+    public void testDeserializeConcreteClassWithoutTypeIdFeatureDisabled() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        // default is disabled, so no need to explicitly disable
+        String json = "{\"name\":\"test\"}";
+        try {
+            mapper.readValue(json, MyImpl.class);
+            fail("Should have thrown an exception");
+        } catch (Exception e) {
+            // expected
+        }
+    }
+
+    // Test that normal type id deserialization still works when feature is enabled
+    public void testDeserializeWithTypeIdFeatureEnabled() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.enable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL);
+        // Register subtype so NAME-based id resolution works
+        mapper.registerSubtypes(MyImpl.class);
+        // With explicit type info
+        String json = "{\"type\":\"MyImpl\",\"name\":\"test\"}";
+        MyInterface result = mapper.readValue(json, MyInterface.class);
+        assertNotNull(result);
+        assertEquals("test", result.getName());
+    }
+
+    // Test with MINIMAL_CLASS type info (as in the issue example)
+    public void testDeserializeConcreteClassMinimalClass() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.enable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL);
+        String json = "{\"name\":\"hello\"}";
+        MyImpl2 result = mapper.readValue(json, MyImpl2.class);
+        assertNotNull(result);
+        assertEquals("hello", result.getName());
+    }
+}
