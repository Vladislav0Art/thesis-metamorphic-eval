diff --git a/build.gradle b/build.gradle
index 7e4c7a868..e7c9c95c6 100644
--- a/build.gradle
+++ b/build.gradle
@@ -855,8 +855,26 @@ tasks.register("decompressJdk") {
     }
 }
 
+tasks.register("generateJdkVersionFile") {
+    dependsOn decompressJdk
+    description = "Generate a VERSION file in the JDK directory, extracting from the release file"
+    doLast {
+        String jdkBundlingDirectory = project.ext.jdkBundlingDirectory
+        File releaseFile = new File("${jdkBundlingDirectory}/release")
+        if (releaseFile.exists()) {
+            String releaseContent = releaseFile.text
+            def matcher = releaseContent =~ /IMPLEMENTOR_VERSION="([^"]+)"/
+            if (matcher.find()) {
+                String jdkVersion = matcher.group(1)
+                new File("${jdkBundlingDirectory}/VERSION").text = jdkVersion
+                println "JDK VERSION file generated with version: ${jdkVersion}"
+            }
+        }
+    }
+}
+
