@@ -57,4 +57,14 @@ describe  FileWatch::BufferedTokenizer  do
       expect(subject.extract("foo||bar")).to eq(["foo"])
     end
   end
+  context "with size limit" do
+    let(:delimiter) { "\n" }
+    subject { FileWatch::BufferedTokenizer.new(delimiter, 10) }
+
+    it "drops buffered content through the next delimiter after overflow" do
+      expect(subject.extract("12345")).to eq([])
+      expect { subject.extract("67890\nok\n") }.to raise_error(IllegalStateException, "input buffer full")
+      expect(subject.extract("next\n")).to eq(["ok", "next"])
+    end
+  end
 end
