@@ -0,0 +1,89 @@
+package org.logstash.plugins.pipeline;
+
+import org.junit.Test;
+import org.logstash.ext.JrubyEventExtLibrary;
+
+import java.time.Duration;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.stream.Stream;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+public class PipelineBusV2Test {
+
+    @Test
+    public void mutateDoesNotDeadlockWhenNotifyingListenerDuringConcurrentMutation() throws InterruptedException {
+        final String address = "fooAddr";
+        final PipelineBusV2.AddressStateMapping mapping = new PipelineBusV2.AddressStateMapping();
+        final TestPipelineInput input = new TestPipelineInput();
+
+        mapping.mutate(address, (addressState) -> addressState.assignInputIfMissing(input));
+
+        final CountDownLatch firstMutationEntered = new CountDownLatch(1);
+        final CountDownLatch listenerMonitorHeld = new CountDownLatch(1);
+        final AtomicReference<Throwable> failure = new AtomicReference<>();
+
+        final Thread firstMutation = new Thread(() -> {
+            try {
+                mapping.mutate(address, (addressState) -> {
+                    firstMutationEntered.countDown();
+                    try {
+                        if (!listenerMonitorHeld.await(1, TimeUnit.SECONDS)) {
+                            throw new AssertionError("listener monitor was not acquired in time");
+                        }
+                    } catch (InterruptedException e) {
+                        throw new RuntimeException(e);
+                    }
+                });
+            } catch (Throwable t) {
+                failure.compareAndSet(null, t);
+            }
+        });
+        firstMutation.setDaemon(true);
+
+        final Thread concurrentMutationHoldingListenerMonitor = new Thread(() -> {
+            try {
+                if (!firstMutationEntered.await(1, TimeUnit.SECONDS)) {
+                    throw new AssertionError("first mutation did not enter in time");
+                }
+
+                synchronized (input) {
+                    listenerMonitorHeld.countDown();
+                    mapping.mutate(address, (addressState) -> { });
+                }
+            } catch (Throwable t) {
+                failure.compareAndSet(null, t);
+            }
+        });
+        concurrentMutationHoldingListenerMonitor.setDaemon(true);
+
+        firstMutation.start();
+        concurrentMutationHoldingListenerMonitor.start();
+
+        firstMutation.join(Duration.ofSeconds(1).toMillis());
+        concurrentMutationHoldingListenerMonitor.join(Duration.ofSeconds(1).toMillis());
+
+        assertThat(failure.get()).isNull();
+        assertThat(firstMutation.isAlive()).isFalse();
+        assertThat(concurrentMutationHoldingListenerMonitor.isAlive()).isFalse();
+    }
+
+    private static class TestPipelineInput implements PipelineInput {
+        @Override
+        public ReceiveResponse internalReceive(final Stream<JrubyEventExtLibrary.RubyEvent> events) {
+            return ReceiveResponse.completed();
+        }
+
+        @Override
+        public String getId() {
+            return "anonymous";
+        }
+
+        @Override
+        public boolean isRunning() {
+            return true;
+        }
+    }
+}
