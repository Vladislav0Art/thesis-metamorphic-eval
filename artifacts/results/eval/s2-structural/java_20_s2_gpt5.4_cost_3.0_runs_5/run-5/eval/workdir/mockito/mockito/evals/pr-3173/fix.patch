+++ b/subprojects/junitJupiterInlineMockMakerExtensionTest/src/test/java/org/mockitousage/GenericSpyRecordTest.java
@@ -0,0 +1,33 @@
+package org.mockitousage;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import org.mockito.Spy;
+
+class GenericSpyRecordTest {
+
+    @Spy
+    private final List<String> genericSpy = List.of("item A", "item B");
+
+    @Spy
+    private ExampleFinalClass example = new ExampleFinalClass("some value");
+
+    @Test
+    void genericSpyDoesNotBreakFinalSpy() {
+        assertEquals("some value", example.someParameter());
+    }
+
+    static final class ExampleFinalClass {
+        private final String someParameter;
+
+        ExampleFinalClass(String someParameter) {
+            this.someParameter = someParameter;
+        }
+
+        String someParameter() {
+            return someParameter;
+        }
+    }
+}
