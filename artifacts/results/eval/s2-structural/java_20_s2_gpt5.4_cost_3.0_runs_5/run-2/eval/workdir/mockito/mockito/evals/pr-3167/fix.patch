+ * This program is made available under the terms of the MIT License.
+ */
+package org.mockitousage;
+
+import org.junit.jupiter.api.Test;
+import org.mockito.Mock;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Answers.RETURNS_DEEP_STUBS;
+import static org.mockito.Mockito.when;
+
+class DeepStubEnumMockTest {
+
+    @Mock(answer = RETURNS_DEEP_STUBS)
+    private Piece piece;
+
+    @Test
+    void deep_stub_can_mock_enum_return_type() {
+        when(piece.getPieceType().getCostPerPieceSpace()).thenReturn(2.5d);
+
+        assertThat(piece.getPieceType().getCostPerPieceSpace()).isEqualTo(2.5d);
+    }
+
+    interface Piece {
+        PieceType getPieceType();
+    }
+
+    enum PieceType {
+        SQUARE(2.0d);
+
+        private final double costPerPieceSpace;
+
+        PieceType(double costPerPieceSpace) {
+            this.costPerPieceSpace = costPerPieceSpace;
+        }
+
+        double getCostPerPieceSpace() {
+            return costPerPieceSpace;
+        }
+    }
+}
