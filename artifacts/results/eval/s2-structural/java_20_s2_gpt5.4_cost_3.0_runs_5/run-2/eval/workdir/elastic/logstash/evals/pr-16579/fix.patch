index cccb9c476..f7eaa4b55 100644
--- a/logstash-core/spec/logstash/util/buftok_spec.rb
+++ b/logstash-core/spec/logstash/util/buftok_spec.rb
@@ -57,4 +57,17 @@ describe  FileWatch::BufferedTokenizer  do
       expect(subject.extract("foo||bar")).to eq(["foo"])
     end
   end
+
+  context "with size limit" do
+    subject { FileWatch::BufferedTokenizer.new("\n", size_limit) }
+
+    let(:size_limit) { 10 }
+
+    it "discards oversized payload content until the next delimiter and resumes tokenizing" do
+      expect(subject.extract("12345")).to eq([])
+      expect { subject.extract("678901") }.to raise_error(IllegalStateException, "input buffer full")
+      expect(subject.extract("d\nok\n")).to eq(["ok"])
+      expect(subject.extract("good\n")).to eq(["good"])
+    end
+  end
 end
