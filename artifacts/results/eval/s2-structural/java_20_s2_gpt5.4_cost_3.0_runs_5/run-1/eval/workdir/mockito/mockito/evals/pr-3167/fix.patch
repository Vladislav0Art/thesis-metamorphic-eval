+package org.mockitousage;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.Answers;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.mockito.Mockito.when;
+
+@ExtendWith(MockitoExtension.class)
+class DeepStubEnumMockTest {
+
+    @Mock(answer = Answers.RETURNS_DEEP_STUBS)
+    private Piece piece;
+
+    @Test
+    void deep_stub_can_chain_through_enum_return_type() {
+        when(piece.getPieceType().getCostPerPieceSpace()).thenReturn(2.5d);
+
+        assertEquals(2.5d, piece.getPieceType().getCostPerPieceSpace());
+    }
+
+    static class Piece {
+        PieceType getPieceType() {
+            return null;
+        }
+    }
+
+    enum PieceType {
+        SQUARE(2.5d),
+        CIRCLE(1.5d);
+
+        private final double costPerPieceSpace;
+
+        PieceType(double costPerPieceSpace) {
+            this.costPerPieceSpace = costPerPieceSpace;
+        }
+
+        double getCostPerPieceSpace() {
+            return costPerPieceSpace;
+        }
+    }
+}
