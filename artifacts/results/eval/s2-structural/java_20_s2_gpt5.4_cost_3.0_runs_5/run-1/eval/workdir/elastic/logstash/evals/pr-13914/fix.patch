@@ -860,6 +854,23 @@ tasks.register("copyJdk", Copy) {
     description = "Download, unpack and copy the JDK"
     // CLI project properties: -Pjdk_bundle_os=[windows|linux|darwin] -Pjdk_arch=[arm64|x86_64]
     doLast {
+        File bundledJdkDir = file(project.ext.jdkBundlingDirectory)
+        File releaseFile = file("${project.ext.jdkBundlingDirectory}/release")
+        if (!releaseFile.exists() && selectOsType() == "darwin") {
+            releaseFile = file("${project.ext.jdkBundlingDirectory}/Contents/Home/release")
+        }
+        if (!releaseFile.exists()) {
+            throw new GradleException("Could not find JDK release file in ${project.ext.jdkBundlingDirectory}")
+        }
+
+        String implementorVersionLine = releaseFile.readLines().find { it.startsWith("IMPLEMENTOR_VERSION=") }
+        if (implementorVersionLine == null) {
+            throw new GradleException("Could not find IMPLEMENTOR_VERSION in ${releaseFile}")
+        }
+
+        String implementorVersion = implementorVersionLine.split("=", 2)[1].replaceAll('^"|"$', '')
+        file("${bundledJdkDir}/VERSION").text = "${implementorVersion}\n"
+
         System.out.println "Download location is ${project.ext.jdkDownloadLocation}, Decompressing ${project.ext.jdkDirectory} to \"${project.ext.jdkBundlingDirectory}\""
     }
 }
