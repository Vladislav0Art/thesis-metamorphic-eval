+    @Test
+    public void whenBlockingUnlistenAndSenderShutdownOverlapTheyDoNotDeadlock() throws Exception {
+        bus.registerSender(output, addresses);
+        bus.listen(input, address);
+        bus.setBlockOnUnlisten(true);
+
+        final int attempts = 100;
+        for (int i = 0; i < attempts; i++) {
+            final CountDownLatch started = new CountDownLatch(1);
+            final Thread unlistenThread = new Thread(() -> {
+                started.countDown();
+                try {
+                    bus.unlisten(input, address);
+                } catch (InterruptedException e) {
+                    throw new RuntimeException(e);
+                }
+            });
+            unlistenThread.start();
+
+            started.await();
+            final Thread unregisterThread = new Thread(() -> bus.unregisterSender(output, addresses));
+            unregisterThread.start();
+
+            unlistenThread.join(Duration.ofSeconds(5).toMillis());
+            unregisterThread.join(Duration.ofSeconds(5).toMillis());
+
+            assertThat(unlistenThread.getState()).isEqualTo(Thread.State.TERMINATED);
+            assertThat(unregisterThread.getState()).isEqualTo(Thread.State.TERMINATED);
+            assertThat(bus.getAddressState(address)).isNotPresent();
+
+            if (i + 1 < attempts) {
+                bus.registerSender(output, addresses);
+                bus.listen(input, address);
+            }
+        }
+    }
 
