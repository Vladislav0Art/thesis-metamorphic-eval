   end
+  context 'with size limit' do
+    subject { FileWatch::BufferedTokenizer.new("\n", size_limit) }
+
+    let(:size_limit) { 10 }
+
+    it "drops oversized buffered content and resumes after the next delimiter" do
+      expect(subject.extract("abcde")).to eq([])
+
+      expect { subject.extract("fghijK\nok\n") }.to raise_error(/input buffer full/)
+
+      expect(subject.extract("next\n")).to eq(["ok", "next"])
+    end
+  end
