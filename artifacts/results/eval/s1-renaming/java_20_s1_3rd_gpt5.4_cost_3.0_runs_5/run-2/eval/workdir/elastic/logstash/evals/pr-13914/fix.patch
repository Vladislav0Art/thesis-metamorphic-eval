diff --git a/build.gradle b/build.gradle
index 7e4c7a868..f5f6cd78d 100644
--- a/build.gradle
+++ b/build.gradle
@@ -860,6 +860,13 @@ tasks.register("copyJdk", Copy) {
     description = "Download, unpack and copy the JDK"
     // CLI project properties: -Pjdk_bundle_os=[windows|linux|darwin] -Pjdk_arch=[arm64|x86_64]
     doLast {
+        def releaseFile = file("${project.ext.jdkBundlingDirectory}/release")
+        def versionFile = file("${project.ext.jdkBundlingDirectory}/VERSION")
+        def releaseMatcher = releaseFile.text =~ /(?m)^IMPLEMENTOR_VERSION="([^"]+)"$/
+        if (!releaseMatcher.find()) {
+            throw new GradleException("Could not determine bundled JDK version from ${releaseFile}")
+        }
+        versionFile.text = "${releaseMatcher.group(1)}\n"
         System.out.println "Download location is ${project.ext.jdkDownloadLocation}, Decompressing ${project.ext.jdkDirectory} to \"${project.ext.jdkBundlingDirectory}\""
     }
 }
