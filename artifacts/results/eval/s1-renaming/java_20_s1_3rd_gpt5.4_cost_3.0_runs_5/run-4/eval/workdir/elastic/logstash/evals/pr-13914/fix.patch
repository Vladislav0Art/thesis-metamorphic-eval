diff --git a/build.gradle b/build.gradle
index 7e4c7a868..16ade0fee 100644
--- a/build.gradle
+++ b/build.gradle
@@ -861,6 +861,19 @@ tasks.register("copyJdk", Copy) {
     // CLI project properties: -Pjdk_bundle_os=[windows|linux|darwin] -Pjdk_arch=[arm64|x86_64]
     doLast {
         System.out.println "Download location is ${project.ext.jdkDownloadLocation}, Decompressing ${project.ext.jdkDirectory} to \"${project.ext.jdkBundlingDirectory}\""
+
+        String osName = selectOsType()
+        String releaseFilePath = osName == "darwin" ? "${project.ext.jdkBundlingDirectory}/Contents/Home/release" : "${project.ext.jdkBundlingDirectory}/release"
+        File releaseFile = file(releaseFilePath)
+        if (!releaseFile.exists()) {
+            throw new GradleException("Could not find JDK release file at ${releaseFilePath}")
+        }
+
+        Properties releaseProperties = new Properties()
+        releaseFile.withInputStream { stream -> releaseProperties.load(stream) }
+
+        String bundledJdkVersion = releaseProperties.getProperty("IMPLEMENTOR_VERSION", releaseProperties.getProperty("JAVA_VERSION", "")).replace("\"", "")
+        file("${project.ext.jdkBundlingDirectory}/VERSION").text = "${bundledJdkVersion}\n"
     }
 }
 
