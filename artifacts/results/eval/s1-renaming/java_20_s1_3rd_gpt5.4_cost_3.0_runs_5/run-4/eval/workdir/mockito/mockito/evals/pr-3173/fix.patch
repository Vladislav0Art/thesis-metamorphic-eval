+package org.mockitousage;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.Spy;
+import org.mockito.junit.jupiter.MockitoExtension;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+
+@ExtendWith(MockitoExtension.class)
+class GenericSpyDoesNotBreakFinalSpyTest {
+
+    @Spy
+    private final List<String> genericSpy = List.of("item A", "item B");
+
+    @Spy
+    private FinalValue finalValue = new FinalValue("some value");
+
+    @Test
+    void generic_spy_does_not_reset_existing_final_inline_spy_state() {
+        assertNotNull(genericSpy);
+        assertNotNull(finalValue.value());
+        assertEquals("some value", finalValue.value());
+    }
+
+    static final class FinalValue {
+        private final String value;
+
+        FinalValue(String value) {
+            this.value = value;
+        }
+
+        String value() {
+            return value;
+        }
+    }
+}
