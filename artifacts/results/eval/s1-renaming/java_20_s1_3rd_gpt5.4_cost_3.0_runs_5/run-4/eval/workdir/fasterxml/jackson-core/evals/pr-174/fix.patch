         ptr = ptr.nextSegment();
         assertTrue(ptr.matchesFully());
-        assertNull(ptr.nextSegment());
+    }
+
+    public void testLeafSegment() throws Exception
+    {
+        JsonPointerReference ptr = JsonPointerReference.parse("/Image/15/name");
+        assertEquals("/name", ptr.leafSegment().toString());
+        assertEquals("/name", ptr.getLast().toString());
+        assertEquals("/name", ptr.nextSegment().nextSegment().leafSegment().toString());
+
+        ptr = JsonPointerReference.parse("/score/-");
+        assertEquals("/-", ptr.leafSegment().toString());
+        assertEquals("/-", ptr.getLast().toString());
+
+        ptr = JsonPointerReference.parse("/name");
+        assertEquals("/name", ptr.leafSegment().toString());
+        assertEquals("/name", ptr.getLast().toString());
+
+        assertNull(JsonPointerReference.parse("").leafSegment());
+        assertNull(JsonPointerReference.parse("").getLast());
     }
