+        } else {
+            realMethod = new RealMethodCall(selfCallInfo, origin, instance, arguments);
+        }
+        return new ReturnValueWrapper(
+                interceptor.doIntercept(
+                        instance, origin, arguments, realMethod, LocationFactory.create(true)));
+    }
