@@ -56,5 +56,15 @@ describe  FileWatch::BufferedTokenizer  do
       expect(subject.extract("")).to eq([])
       expect(subject.extract("foo||bar")).to eq(["foo"])
     end
+
+    it "drops oversized buffered data and resumes after the next delimiter" do
+      tokenizer = FileWatch::BufferedTokenizer.new(delimiter, 10)
+
+      expect(tokenizer.extract("12345")).to eq([])
+      expect { tokenizer.extract("678901||ok||") }.to raise_error(Java::JavaLang::IllegalStateException, "input buffer full")
+
+      expect(tokenizer.extract("next||")).to eq(["next"])
+      expect(tokenizer.extract("fresh||")).to eq(["fresh"])
+    end
   end
 end
