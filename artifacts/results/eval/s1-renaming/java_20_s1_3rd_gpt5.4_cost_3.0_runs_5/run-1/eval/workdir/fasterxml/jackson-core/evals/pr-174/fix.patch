diff --git a/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java b/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java
index e2c21487..d433a089 100644
--- a/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java
+++ b/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java
@@ -102,4 +102,18 @@ public class TestJsonPointer extends BaseTest
         assertTrue(ptr.matchesFully());
         assertNull(ptr.nextSegment());
     }
+    public void testLeafSegment() throws Exception
+    {
+        JsonPointerReference ptr = JsonPointerReference.parse("/score/-");
+        JsonPointerReference leaf = ptr.leafSegment();
+
+        assertEquals("/-", leaf.toString());
+        assertEquals("-", leaf.getMatchingProperty());
+        assertEquals(-1, leaf.getMatchingIndex());
+        assertSame(leaf, ptr.getLast());
+
+        JsonPointerReference single = JsonPointerReference.parse("/score");
+        assertSame(single, single.leafSegment());
+        assertSame(single, single.getLast());
+    }
