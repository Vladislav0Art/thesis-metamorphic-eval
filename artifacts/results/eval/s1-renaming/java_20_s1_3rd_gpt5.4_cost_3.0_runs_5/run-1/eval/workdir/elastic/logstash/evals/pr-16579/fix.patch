index cccb9c476..8843b564e 100644
--- a/logstash-core/spec/logstash/util/buftok_spec.rb
+++ b/logstash-core/spec/logstash/util/buftok_spec.rb
@@ -57,4 +57,16 @@ describe  FileWatch::BufferedTokenizer  do
       expect(subject.extract("foo||bar")).to eq(["foo"])
     end
   end
+
+  context "with size limit" do
+    subject { FileWatch::BufferedTokenizer.new("\n", 10) }
+
+    it "drops the oversized payload and resumes after the next delimiter" do
+      expect(subject.extract("12345678")).to eq([])
+
+      expect { subject.extract("901\nok\n") }.to raise_error(IllegalStateException, "input buffer full")
+
+      expect(subject.extract("rest-of-big\nok\n")).to eq(["ok"])
+    end
+  end
 end
