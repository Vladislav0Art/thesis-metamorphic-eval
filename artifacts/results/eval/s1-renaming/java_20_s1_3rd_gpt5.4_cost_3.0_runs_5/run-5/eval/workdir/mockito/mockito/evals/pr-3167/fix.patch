+ */
+package org.mockitousage.bugs.deepstubs;
+
+import static org.junit.Assert.assertEquals;
+import static org.mockito.Mockito.RETURNS_DEEP_STUBS;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import org.junit.Test;
+import org.mockito.MockMakers;
+import org.mockito.Mockito;
+
+public class DeepStubsWithEnumReturnTypeTest {
+
+    interface Piece {
+        PieceType getPieceType();
+    }
+
+    enum PieceType {
+        SQUARE(2.0d),
+        CIRCLE(2.5d);
+
+        private final double costPerPieceSpace;
+
+        PieceType(double costPerPieceSpace) {
+            this.costPerPieceSpace = costPerPieceSpace;
+        }
+
+        double getCostPerPieceSpace() {
+            return costPerPieceSpace;
+        }
+    }
+
+    @Test
+    public void deep_stubs_can_stub_enum_return_type_with_inline_mock_maker() {
+        Piece piece =
+                mock(
+                        Piece.class,
+                        Mockito.withSettings()
+                                .mockMaker(MockMakers.INLINE)
+                                .defaultAnswer(RETURNS_DEEP_STUBS));
+
+        when(piece.getPieceType().getCostPerPieceSpace()).thenReturn(2.5d);
+
+        assertEquals(2.5d, piece.getPieceType().getCostPerPieceSpace(), 0.0d);
+    }
+}
