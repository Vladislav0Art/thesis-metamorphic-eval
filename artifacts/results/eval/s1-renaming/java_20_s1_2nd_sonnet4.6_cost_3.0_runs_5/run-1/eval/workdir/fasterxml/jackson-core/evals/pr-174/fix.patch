+    /**
+     * Accessor for getting the last segment of this pointer expression.
+     * For example, for "/a/b/c" returns a pointer that represents "/c".
+     * If this pointer is empty (matches current node), returns null.
+     *
+     * @since 2.5
+     */
+    public JsonPointerReference getLast() {
+        if (matchesFully()) {
+            return null;
+        }
+        JsonPointerReference current = this;
+        while (true) {
+            JsonPointerReference next = current._nextSegment;
+            if (next == null || next.matchesFully()) {
+                return current;
+            }
+            current = next;
+        }
+    }
