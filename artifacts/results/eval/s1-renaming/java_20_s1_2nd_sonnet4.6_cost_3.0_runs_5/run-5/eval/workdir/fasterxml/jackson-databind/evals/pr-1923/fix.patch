+    // // // Test for [databind#1972]: NPE with Spring interface
+    public void testSpringInterfaceType1972() throws Exception
+    {
+        // This should NOT throw a NullPointerException; Spring interfaces
+        // in org.springframework.* package caused NPE before fix
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.enableDefaultTyping(ObjectMapper.DefaultTyping.NON_FINAL, JsonTypeInfo.As.PROPERTY);
+
+        String json = aposToQuotes("{'@class':'org.springframework.jacksontest.BogusAuthentication','authorities':['java.util.ArrayList',[]]}");
+        org.springframework.jacksontest.BogusAuthentication result = mapper.readValue(json,
+                org.springframework.jacksontest.BogusAuthentication.class);
+        assertNotNull(result);
+    }
+
     // 17-Aug-2017, tatu: Ideally would test handling of 3rd party types, too,
     //    but would require adding dependencies. This may be practical when
     //    checking done by module, but for now let's not do that for databind.
