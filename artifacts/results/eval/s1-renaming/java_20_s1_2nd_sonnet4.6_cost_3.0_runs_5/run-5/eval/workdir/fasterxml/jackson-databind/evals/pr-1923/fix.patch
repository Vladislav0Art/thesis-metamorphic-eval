+package org.springframework.jacksontest;
+
+import java.util.*;
+
+// Made-up test class that should trigger checks for [databind#1972]
+public class BogusAuthentication {
+    private List<BogusGrantedAuthority> authorities = new ArrayList<BogusGrantedAuthority>();
+
+    public List<BogusGrantedAuthority> getAuthorities() {
+        return this.authorities;
+    }
+
+    public void setAuthorities(List<BogusGrantedAuthority> authorities) {
+        this.authorities = authorities;
+    }
+}
