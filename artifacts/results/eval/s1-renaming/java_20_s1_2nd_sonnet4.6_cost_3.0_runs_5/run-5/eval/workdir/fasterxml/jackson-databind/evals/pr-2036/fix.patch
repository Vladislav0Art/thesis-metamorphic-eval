diff --git a/src/test/java/com/fasterxml/jackson/databind/jsontype/UseBaseTypeAsDefaultImplTest.java b/src/test/java/com/fasterxml/jackson/databind/jsontype/UseBaseTypeAsDefaultImplTest.java
new file mode 100644
index 000000000..ad956c796
--- /dev/null
+++ b/src/test/java/com/fasterxml/jackson/databind/jsontype/UseBaseTypeAsDefaultImplTest.java
@@ -0,0 +1,56 @@
+package com.fasterxml.jackson.databind.jsontype;
+
+import com.fasterxml.jackson.annotation.*;
+import com.fasterxml.jackson.databind.*;
+import com.fasterxml.jackson.databind.exc.InvalidTypeIdException;
+
+/**
+ * Tests for MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL
+ */
+public class UseBaseTypeAsDefaultImplTest extends BaseMapTest
+{
+    @JsonTypeInfo(use = JsonTypeInfo.Id.MINIMAL_CLASS, include = JsonTypeInfo.As.PROPERTY, property = "type")
+    public interface MyInterface {
+        String getName();
+        void setName(String name);
+    }
+
+    public static class MyClass implements MyInterface {
+        private String name;
+        public String getName() { return name; }
+        public void setName(String name) { this.name = name; }
+    }
+
+    // Test that with feature disabled (default), missing type info causes exception
+    public void testWithoutFeature() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        String json = "{\"name\":\"test\"}";
+        try {
+            mapper.readValue(json, MyClass.class);
+            fail("Should have thrown exception without type info");
+        } catch (InvalidTypeIdException e) {
+            // expected
+        }
+    }
+
+    // Test that with feature enabled, missing type info uses base type
+    public void testWithFeatureEnabled() throws Exception {
+        ObjectMapper mapper = new ObjectMapper()
+            .enable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL);
+        String json = "{\"name\":\"testValue\"}";
+        MyClass result = mapper.readValue(json, MyClass.class);
+        assertNotNull(result);
+        assertEquals("testValue", result.getName());
+    }
+
+    // Test that with feature enabled, explicit type info still works
+    public void testWithFeatureEnabledAndTypeInfoPresent() throws Exception {
+        ObjectMapper mapper = new ObjectMapper()
+            .enable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL);
+        String json = "{\"name\":\"testValue\",\"type\":\".UseBaseTypeAsDefaultImplTest$MyClass\"}";
+        MyInterface result = mapper.readValue(json, MyInterface.class);
+        assertNotNull(result);
+        assertTrue(result instanceof MyClass);
+        assertEquals("testValue", result.getName());
+    }
+}
