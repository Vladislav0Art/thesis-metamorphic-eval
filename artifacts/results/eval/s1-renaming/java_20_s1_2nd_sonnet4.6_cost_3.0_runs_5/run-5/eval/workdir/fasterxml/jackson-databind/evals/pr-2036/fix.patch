diff --git a/src/main/java/com/fasterxml/jackson/databind/MapperFeature.java b/src/main/java/com/fasterxml/jackson/databind/MapperFeature.java
index 967fb8964..a310a122a 100644
--- a/src/main/java/com/fasterxml/jackson/databind/MapperFeature.java
+++ b/src/main/java/com/fasterxml/jackson/databind/MapperFeature.java
@@ -474,7 +474,25 @@ public enum MapperFeature implements ConfigFeature
      *
      * @since 2.9
      */
-    IGNORE_MERGE_FOR_UNMERGEABLE(true)
+    IGNORE_MERGE_FOR_UNMERGEABLE(true),
+
+    /**
+     * Feature that determines whether the declared base type of a polymorphic value
+     * is used as the "default implementation" if no type information is found (including
+     * if type information is present but does not match any registered sub-type).
+     * When enabled, the declared base type is used for instantiation if no other type
+     * information is found; when disabled (default), an exception is thrown if no type
+     * information can be found.
+     *<p>
+     * This feature is most useful with concrete classes that have type info annotations
+     * (or are part of type hierarchy with such annotations), but where the caller knows
+     * the concrete type and just wants to deserialize into it if type info is missing.
+     *<p>
+     * Feature is disabled by default.
+     *
+     * @since 2.10
+     */
+    USE_BASE_TYPE_AS_DEFAULT_IMPL(false)
 
     ;
 
