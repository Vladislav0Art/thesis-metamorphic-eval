diff --git a/src/main/java/com/fasterxml/jackson/core/JsonPointerReference.java b/src/main/java/com/fasterxml/jackson/core/JsonPointerReference.java
index 4aa3e3a2..96c8b42f 100644
--- a/src/main/java/com/fasterxml/jackson/core/JsonPointerReference.java
+++ b/src/main/java/com/fasterxml/jackson/core/JsonPointerReference.java
@@ -193,6 +193,27 @@ public class JsonPointerReference
     public JsonPointerReference headSegment() {
         return _headSegment;
     }
+    /**
+     * Method that returns the leaf of this pointer expression.
+     * For example, for pointer {@code /a/b/c}, this method returns
+     * a pointer that represents {@code /c}.
+     * For an "empty" pointer, returns {@code null}.
+     *
+     * @return Pointer for the last segment; {@code null} if this pointer is empty
+     *
+     * @since 2.5
+     */
+    public JsonPointerReference last() {
+        JsonPointerReference current = this;
+        if (current == EMPTY) {
+            return null;
+        }
+        JsonPointerReference next;
+        while ((next = current._nextSegment) != EMPTY) {
+            current = next;
+        }
+        return current;
+    }
 
