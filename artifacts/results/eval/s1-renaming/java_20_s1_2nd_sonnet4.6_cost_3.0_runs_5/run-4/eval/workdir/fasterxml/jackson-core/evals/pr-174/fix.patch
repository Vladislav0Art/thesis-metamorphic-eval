     /**********************************************************
diff --git a/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java b/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java
index e2c21487..32eecddc 100644
--- a/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java
+++ b/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java
@@ -100,6 +100,33 @@ public class TestJsonPointer extends BaseTest
         // done!
         ptr = ptr.nextSegment();
         assertTrue(ptr.matchesFully());
-        assertNull(ptr.nextSegment());
+    }
+
+    public void testLastMethod() throws Exception
+    {
+        // simple path
+        JsonPointerReference ptr = JsonPointerReference.parse("/Image/15/name");
+        JsonPointerReference last = ptr.last();
+        assertNotNull(last);
+        assertEquals("name", last.getMatchingProperty());
+        assertEquals("/name", last.toString());
+
+        // single segment
+        ptr = JsonPointerReference.parse("/name");
+        last = ptr.last();
+        assertNotNull(last);
+        assertEquals("name", last.getMatchingProperty());
+
+        // array append indicator
+        ptr = JsonPointerReference.parse("/score/-");
+        last = ptr.last();
+        assertNotNull(last);
+        assertEquals("-", last.getMatchingProperty());
+        assertEquals("/-", last.toString());
+
+        // empty pointer
+        ptr = JsonPointerReference.parse("");
+        last = ptr.last();
+        assertNull(last);
     }
 }
