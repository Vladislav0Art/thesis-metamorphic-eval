diff --git a/core/src/test/java/com/alibaba/fastjson2/JSONValidatorTest.java b/core/src/test/java/com/alibaba/fastjson2/JSONValidatorTest.java
index d679fd05f..0ee6c7b51 100644
--- a/core/src/test/java/com/alibaba/fastjson2/JSONValidatorTest.java
+++ b/core/src/test/java/com/alibaba/fastjson2/JSONValidatorTest.java
@@ -5,6 +5,7 @@ import org.junit.jupiter.api.Test;
 import java.nio.charset.StandardCharsets;
 
 import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
 
 public class JSONValidatorTest {
     @Test
@@ -15,4 +16,33 @@ public class JSONValidatorTest {
         assertFalse(JsonMapper.isValid(utf8, 0, utf8.length, StandardCharsets.UTF_8));
         assertFalse(JsonMapper.isValid(utf8, 0, utf8.length, StandardCharsets.US_ASCII));
     }
+
+    @Test
+    public void validate_test_objectVsArray() {
+        // isValid should only return true for JSON Objects
+        assertTrue(JsonMapper.isValid("{}"));
+        assertTrue(JsonMapper.isValid("{\"key\": 1}"));
+        assertFalse(JsonMapper.isValid("[]"));
+        assertFalse(JsonMapper.isValid("[1,2,3]"));
+
+        // isValidArray should only return true for JSON Arrays
+        assertTrue(JsonMapper.isValidArray("[]"));
+        assertTrue(JsonMapper.isValidArray("[1,2,3]"));
+        assertFalse(JsonMapper.isValidArray("{}"));
+        assertFalse(JsonMapper.isValidArray("{\"key\": 1}"));
+
+        // Test byte[] versions
+        byte[] objectBytes = "{}".getBytes(StandardCharsets.UTF_8);
+        byte[] arrayBytes = "[]".getBytes(StandardCharsets.UTF_8);
+
+        assertTrue(JsonMapper.isValid(objectBytes));
+        assertFalse(JsonMapper.isValid(arrayBytes));
+
+        assertFalse(JsonMapper.isValidArray(objectBytes));
+        assertTrue(JsonMapper.isValidArray(arrayBytes));
+
+        // Test byte[] with offset/length/charset versions
+        assertTrue(JsonMapper.isValid(objectBytes, 0, objectBytes.length, StandardCharsets.UTF_8));
+        assertFalse(JsonMapper.isValid(arrayBytes, 0, arrayBytes.length, StandardCharsets.UTF_8));
+    }
 }
