diff --git a/src/main/java/org/mockito/plugins/MockitoPluginProvider.java b/src/main/java/org/mockito/plugins/MockitoPluginProvider.java
index f7409ee2a..f53d80e5a 100644
--- a/src/main/java/org/mockito/plugins/MockitoPluginProvider.java
+++ b/src/main/java/org/mockito/plugins/MockitoPluginProvider.java
@@ -41,4 +41,21 @@ public interface MockitoPluginProvider {
      * @since 2.10.0
      */
     MockMaker getInlineMockMaker();
+
+    /**
+     * Returns the mock maker identified by the given type or alias. Unlike {@link #getInlineMockMaker()},
+     * this method reuses existing instances, so calling this method multiple times with the same argument
+     * will return the same instance. This is important for framework integrations that share the same
+     * mock maker, so they do not interfere with each other.
+     *
+     * <p>Note that the default mock maker (i.e. the result of {@code getMockMaker(null)}) is always
+     * the same as the one returned by {@link MockMaker} plugin resolver (typically configured via
+     * {@code mockito-extensions/org.mockito.plugins.MockMaker}).
+     *
+     * @param mockMaker the fully qualified class name or a mock maker alias (e.g.
+     *     {@link org.mockito.MockMakers#INLINE}), or {@code null} for the default mock maker
+     * @return the mock maker instance
+     * @since 5.0.0
+     */
+    MockMaker getMockMaker(String mockMaker);
 }
