diff --git a/src/main/java/org/mockito/plugins/MockitoPluginRegistry.java b/src/main/java/org/mockito/plugins/MockitoPluginRegistry.java
index 651d420b3..c466004eb 100644
--- a/src/main/java/org/mockito/plugins/MockitoPluginRegistry.java
+++ b/src/main/java/org/mockito/plugins/MockitoPluginRegistry.java
@@ -36,9 +36,27 @@ public interface MockitoPluginRegistry {
      * This method is needed because {@link #getDefaultPlugin(Class)} does not provide an instance of inline mock maker.
      * Creates new instance each time is called so it is recommended to keep hold of the resulting object for future invocations.
      * For more information about inline mock maker see the javadoc for main {@link Mockito} class.
-     *
      * @return instance of inline mock maker
      * @since 2.10.0
      */
     MockMaker getInlineMockMaker();
+
+    /**
+     * Returns a mock maker by its type or alias key.
+     * The mock maker instances are shared (reused), so it is safe to call this method multiple times.
+     * Use this method instead of {@link #getInlineMockMaker()} to avoid creating multiple instances
+     * of the same mock maker, which can cause unexpected behavior when frameworks try to use
+     * the same mock maker concurrently (e.g., when both Mockito and another framework try to mock
+     * the same class).
+     *
+     * <p>Supported aliases are defined in {@link org.mockito.MockMakers}.
+     * You can also pass a fully qualified class name of a custom mock maker.
+     *
+     * @param mockMakerKey the alias (e.g. {@link org.mockito.MockMakers#INLINE}) or
+     *                     fully qualified class name of the mock maker, or {@code null}
+     *                     to get the default mock maker
+     * @return the shared mock maker instance
+     * @since 5.0.0
+     */
+    MockMaker getMockMaker(String mockMakerKey);
 }
