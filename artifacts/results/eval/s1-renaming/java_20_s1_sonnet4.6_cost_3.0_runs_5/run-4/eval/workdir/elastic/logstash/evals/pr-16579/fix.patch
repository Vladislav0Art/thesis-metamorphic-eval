diff --git a/logstash-core/spec/logstash/util/buftok_spec.rb b/logstash-core/spec/logstash/util/buftok_spec.rb
index cccb9c476..b87118b50 100644
--- a/logstash-core/spec/logstash/util/buftok_spec.rb
+++ b/logstash-core/spec/logstash/util/buftok_spec.rb
@@ -57,4 +57,43 @@ describe  FileWatch::BufferedTokenizer  do
       expect(subject.extract("foo||bar")).to eq(["foo"])
     end
   end
+
+  context 'with size limit' do
+    subject { FileWatch::BufferedTokenizer.new("\n", 10) }
+
+    it "should raise an error when the buffer exceeds the size limit" do
+      expect { subject.extract("a" * 11 + "\n") }.to raise_error(RuntimeError, /input buffer full/)
+    end
+
+    it "should reset after a buffer full error and correctly tokenize subsequent input" do
+      # First token is too big - causes buffer full
+      expect { subject.extract("a" * 11 + "\n") }.to raise_error(RuntimeError, /input buffer full/)
+      # Second token is fine - should be returned correctly
+      result = subject.extract("valid\n")
+      expect(result).to eq(["valid"])
+    end
+
+    it "should discard data until separator when buffer was full across multiple chunks" do
+      # Send oversized data in chunks
+      expect { subject.extract("a" * 11) }.to raise_error(RuntimeError, /input buffer full/)
+      # Still in the oversized token - no separator yet, should be discarded
+      expect(subject.extract("more_overflow_data")).to eq([])
+      # Now the separator arrives followed by valid data
+      result = subject.extract("\nvalid\n")
+      expect(result).to eq(["valid"])
+    end
+
+    it "should handle buffer full error followed by multiple valid tokens" do
+      expect { subject.extract("a" * 11 + "\n") }.to raise_error(RuntimeError, /input buffer full/)
+      result = subject.extract("foo\nbar\n")
+      expect(result).to eq(["foo", "bar"])
+    end
+
+    it "should handle the separator being in the same chunk as the end of the oversized token" do
+      expect { subject.extract("a" * 11) }.to raise_error(RuntimeError, /input buffer full/)
+      # The separator is in this chunk: discard tail of oversized token, return valid data
+      result = subject.extract("\nvalid\n")
+      expect(result).to eq(["valid"])
+    end
+  end
 end
