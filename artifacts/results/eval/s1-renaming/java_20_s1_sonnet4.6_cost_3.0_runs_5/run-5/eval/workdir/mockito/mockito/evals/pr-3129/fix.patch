diff --git a/src/main/java/org/mockito/plugins/MockitoPluginRegistry.java b/src/main/java/org/mockito/plugins/MockitoPluginRegistry.java
index 651d420b3..1259c7b61 100644
--- a/src/main/java/org/mockito/plugins/MockitoPluginRegistry.java
+++ b/src/main/java/org/mockito/plugins/MockitoPluginRegistry.java
@@ -41,4 +41,19 @@ public interface MockitoPluginRegistry {
      * @since 2.10.0
      */
     MockMaker getInlineMockMaker();
+
+    /**
+     * Returns a mock maker by its type name or alias.
+     * Unlike {@link #getInlineMockMaker()}, this method returns the same instance each time it is called
+     * with the same {@code mockMaker} argument, reusing the cached instance.
+     * <p>
+     * Use this method instead of {@link #getInlineMockMaker()} to avoid issues caused by having multiple
+     * instances of the same mock maker active at the same time.
+     *
+     * @param mockMaker the fully qualified class name or alias of the mock maker, e.g. {@code "mock-maker-inline"}.
+     *                  If {@code null}, the default mock maker is returned.
+     * @return instance of the requested mock maker
+     * @since 5.0.0
+     */
+    MockMaker getMockMaker(String mockMaker);
 }
