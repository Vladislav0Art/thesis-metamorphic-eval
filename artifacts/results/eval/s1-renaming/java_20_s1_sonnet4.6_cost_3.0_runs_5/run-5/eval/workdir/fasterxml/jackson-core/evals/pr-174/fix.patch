diff --git a/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java b/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java
index 94220d64..0e13ab72 100644
--- a/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java
+++ b/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java
@@ -102,4 +102,25 @@ public class TestJsonPointer extends BaseTest
         assertTrue(ptr.matchesExactly());
         assertNull(ptr.nextSegment());
     }
+
+    public void testGetLast() throws Exception
+    {
+        // Test with "/score/-" - getLast should return the segment for "/-"
+        JsonPointerExpression ptr = JsonPointerExpression.compilePointer("/score/-");
+        JsonPointerExpression last = ptr.getLast();
+        assertNotNull(last);
+        assertEquals("-", last.getMatchingProperty());
+
+        // Test with a single segment - getLast should return that segment itself
+        ptr = JsonPointerExpression.compilePointer("/name");
+        last = ptr.getLast();
+        assertNotNull(last);
+        assertEquals("name", last.getMatchingProperty());
+
+        // Test with multiple segments - getLast should return the last segment
+        ptr = JsonPointerExpression.compilePointer("/Image/15/name");
+        last = ptr.getLast();
+        assertNotNull(last);
+        assertEquals("name", last.getMatchingProperty());
+    }
 }
