index 000000000..05a8b6584
--- /dev/null
+++ b/src/test/java/com/fasterxml/jackson/databind/jsontype/UseBaseTypeAsFallbackTest.java
@@ -0,0 +1,42 @@
+package com.fasterxml.jackson.databind.jsontype;
+
+import com.fasterxml.jackson.annotation.JsonTypeInfo;
+import com.fasterxml.jackson.databind.MapperFeature;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.fasterxml.jackson.databind.BaseMapTest;
+
+public class UseBaseTypeAsFallbackTest extends BaseMapTest
+{
+    @JsonTypeInfo(use = JsonTypeInfo.Id.MINIMAL_CLASS, include = JsonTypeInfo.As.PROPERTY, property = "type")
+    interface MyInterface {
+        String getName();
+        void setName(String name);
+    }
+
+    static class MyClass implements MyInterface {
+        private String name;
+        public String getName() { return name; }
+        public void setName(String name) { this.name = name; }
+    }
+
+    // Test that with feature enabled, deserialization works without type property
+    public void testBaseTypeAsFallback() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.enable(MapperFeature.USE_BASE_TYPE_AS_FALLBACK_IMPLEMENTATION);
+        String json = "{\"name\":\"testName\"}";
+        MyClass result = mapper.readValue(json, MyClass.class);
+        assertEquals("testName", result.getName());
+    }
+
+    // Test that with feature disabled (default), deserialization fails without type property
+    public void testBaseTypeAsFallbackDisabledByDefault() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        String json = "{\"name\":\"testName\"}";
+        try {
+            mapper.readValue(json, MyClass.class);
+            fail("Should have thrown an exception without type info");
+        } catch (Exception e) {
+            // expected
+        }
+    }
+}
