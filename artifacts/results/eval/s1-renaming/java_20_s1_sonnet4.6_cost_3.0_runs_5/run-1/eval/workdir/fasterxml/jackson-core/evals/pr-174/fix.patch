+    /**
+     * Accessor for getting the last segment of this pointer expression.
+     * For example, for expression "/score/-", this would return the
+     * segment "/-". For a single-segment expression like "/score", returns
+     * this instance. For the empty/matching expression, returns this.
+     *
+     * @since 2.6
+     */
+    public JsonPointerExpression getLast() {
+        if (matchesExactly()) {
+            return this;
+        }
+        JsonPointerExpression current = this;
+        while (!current._nextSegment.matchesExactly()) {
+            current = current._nextSegment;
+        }
+        return current;
+    }
