index cccb9c476..fa93dad55 100644
--- a/logstash-core/spec/logstash/util/buftok_spec.rb
+++ b/logstash-core/spec/logstash/util/buftok_spec.rb
@@ -57,4 +57,19 @@ describe  FileWatch::BufferedTokenizer  do
       expect(subject.extract("foo||bar")).to eq(["foo"])
     end
   end
+
+  context "with size limit" do
+    subject { FileWatch::BufferedTokenizer.new("\n", 10) }
+
+    it "discards oversized input through the next delimiter and resumes tokenizing" do
+      expect(subject.extract("12345")).to eq([])
+
+      expect do
+        subject.extract("678901\nok")
+      end.to raise_error(IllegalStateException, "input buffer full")
+
+      expect(subject.extract("\n")).to eq(["ok"])
+      expect(subject.extract("next\n")).to eq(["next"])
+    end
+  end
 end
