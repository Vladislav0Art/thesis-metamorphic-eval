@@ -0,0 +1,45 @@
+import com.alibaba.fastjson2.JsonMapper;
+
+import java.nio.charset.StandardCharsets;
+
+public class ReproJsonMapperValidation {
+    public static void main(String[] args) {
+        if (!JsonMapper.isValid("{}")) {
+            throw new RuntimeException("object should be valid json");
+        }
+        if (!JsonMapper.isValid("[]")) {
+            throw new RuntimeException("array should be valid json");
+        }
+        if (!JsonMapper.isValidObject("{}")) {
+            throw new RuntimeException("object should be valid object");
+        }
+        if (JsonMapper.isValidObject("[]")) {
+            throw new RuntimeException("array should not be valid object");
+        }
+        if (!JsonMapper.isValidArray("[]")) {
+            throw new RuntimeException("array should be valid array");
+        }
+        if (JsonMapper.isValidArray("{}")) {
+            throw new RuntimeException("object should not be valid array");
+        }
+
+        byte[] objectBytes = "{}".getBytes(StandardCharsets.UTF_8);
+        byte[] arrayBytes = "[]".getBytes(StandardCharsets.UTF_8);
+        if (!JsonMapper.isValidObject(objectBytes)) {
+            throw new RuntimeException("object bytes should be valid object");
+        }
+        if (JsonMapper.isValidObject(arrayBytes)) {
+            throw new RuntimeException("array bytes should not be valid object");
+        }
+
+        byte[] wrapped = "xx{}yy".getBytes(StandardCharsets.UTF_8);
+        if (!JsonMapper.isValidObject(wrapped, 2, 2, StandardCharsets.UTF_8)) {
+            throw new RuntimeException("offset object bytes should be valid object");
+        }
+        if (JsonMapper.isValidArray(wrapped, 2, 2, StandardCharsets.UTF_8)) {
+            throw new RuntimeException("offset object bytes should not be valid array");
+        }
+
+        System.out.println("Script completed successfully, no errors.");
+    }
+}
