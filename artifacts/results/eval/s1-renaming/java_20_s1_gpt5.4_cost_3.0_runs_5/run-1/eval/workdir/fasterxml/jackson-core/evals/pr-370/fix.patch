+  @SuppressWarnings("resource")
+  @Test
+  public void testObjectTrailingCommaWithNextPropertyName() throws Exception {
+    if (mode != MODE_READER) {
+      return;
+    }
+
+    String json = "{\"a\": true,}";
+
+    com.fasterxml.jackson.core.json.ReaderBackedJsonParser p =
+        (com.fasterxml.jackson.core.json.ReaderBackedJsonParser) createParser(factory, mode, json);
+
+    assertEquals(JsonToken.START_OBJECT, p.nextToken());
+
+    assertEquals("a", p.nextPropertyName());
+    assertToken(JsonToken.VALUE_TRUE, p.nextToken());
+
+    if (features.contains(Feature.ALLOW_TRAILING_COMMA)) {
+      assertNull(p.nextPropertyName());
+      assertToken(JsonToken.END_OBJECT, p.getCurrentToken());
+      assertEnd(p);
+    } else {
+      assertUnexpected(p, '}');
+    }
+    p.close();
+  }
+
