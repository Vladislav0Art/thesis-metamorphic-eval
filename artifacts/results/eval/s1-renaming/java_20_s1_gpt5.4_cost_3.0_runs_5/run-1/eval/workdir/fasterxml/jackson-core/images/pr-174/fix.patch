+    public JsonPointerExpression getLast() {
+        JsonPointerExpression activePointerExpr = this;
+        while(!JsonPointerExpression.EMPTY.equals(activePointerExpr._nextSegment)) {
+            activePointerExpr = activePointerExpr._nextSegment;
+        }
+        return activePointerExpr;
+    }
