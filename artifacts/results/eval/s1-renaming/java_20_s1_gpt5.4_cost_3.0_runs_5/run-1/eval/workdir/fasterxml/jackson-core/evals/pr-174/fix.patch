diff --git a/src/main/java/com/fasterxml/jackson/core/JsonPointerExpression.java b/src/main/java/com/fasterxml/jackson/core/JsonPointerExpression.java
index 4ec5b4c2..07ab52aa 100644
--- a/src/main/java/com/fasterxml/jackson/core/JsonPointerExpression.java
+++ b/src/main/java/com/fasterxml/jackson/core/JsonPointerExpression.java
@@ -185,15 +185,23 @@ public class JsonPointerExpression
     }
 
     /**
-     * Accessor for getting a "pointer", instance from current segment to
-     * segment before segment leaf. For root pointer, will return null.
+     * Accessor for getting a pointer that contains only the last segment
+     * of this expression; for example, leaf of "/a/b" is "/b".
      *
-     * @since 2.5
+     * @return Last segment of this pointer, if any; {@code null} for the empty pointer
      */
-    public JsonPointerExpression headSegment() {
-        return _headSegment;
+    public JsonPointerExpression getLast() {
+        if (_nextSegment == null) {
+            return null;
+        }
+        if (_nextSegment == EMPTY) {
+            return this;
+        }
+        return _nextSegment.getLast();
     }
 
+    public JsonPointerExpression headSegment() { return _headSegment; }
+
     /*
