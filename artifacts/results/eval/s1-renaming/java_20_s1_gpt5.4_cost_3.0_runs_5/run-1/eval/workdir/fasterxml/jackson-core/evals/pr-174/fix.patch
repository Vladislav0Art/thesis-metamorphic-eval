     /* Standard method overrides
diff --git a/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java b/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java
index 94220d64..e3fc7ae8 100644
--- a/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java
+++ b/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java
@@ -102,4 +102,19 @@ public class TestJsonPointer extends BaseTest
         assertTrue(ptr.matchesExactly());
         assertNull(ptr.nextSegment());
     }
+
+    public void testGetLast() throws Exception
+    {
+        JsonPointerExpression ptr = JsonPointerExpression.compilePointer("");
+        assertNull(ptr.getLast());
+
+        ptr = JsonPointerExpression.compilePointer("/score/-");
+        assertEquals("/-", ptr.getLast().toString());
+
+        ptr = JsonPointerExpression.compilePointer("/a");
+        assertEquals("/a", ptr.getLast().toString());
+
+        ptr = JsonPointerExpression.compilePointer("/a/b");
+        assertEquals("/b", ptr.getLast().toString());
+    }
 }
