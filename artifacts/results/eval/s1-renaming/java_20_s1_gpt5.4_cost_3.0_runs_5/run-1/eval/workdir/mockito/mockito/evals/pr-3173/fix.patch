index 000000000..7be355ef8
--- /dev/null
+++ b/subprojects/java21/src/test/java/org/mockito/java21/RecordSpyWithGenericSpyTest.java
@@ -0,0 +1,25 @@
+package org.mockito.java21;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.List;
+
+import org.junit.Test;
+import org.mockito.MockitoAnnotations;
+import org.mockito.Spy;
+
+public class RecordSpyWithGenericSpyTest {
+
+    @Spy private final List<String> genericSpy = List.of("item A", "item B");
+
+    @Spy private ExampleRecord exampleRecord = new ExampleRecord("some value");
+
+    @Test
+    public void should_preserve_record_state_when_generic_spy_is_present() throws Exception {
+        MockitoAnnotations.openMocks(this);
+
+        assertThat(exampleRecord.someParameter()).isEqualTo("some value");
+    }
+
+    record ExampleRecord(String someParameter) {}
+}
