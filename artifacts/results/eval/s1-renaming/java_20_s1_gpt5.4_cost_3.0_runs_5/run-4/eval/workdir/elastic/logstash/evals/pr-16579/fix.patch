index cccb9c476..878de027e 100644
--- a/logstash-core/spec/logstash/util/buftok_spec.rb
+++ b/logstash-core/spec/logstash/util/buftok_spec.rb
@@ -57,4 +57,24 @@ describe  FileWatch::BufferedTokenizer  do
       expect(subject.extract("foo||bar")).to eq(["foo"])
     end
   end
+
+  context "with size limit" do
+    subject { FileWatch::BufferedTokenizer.new("\n", 10) }
+
+    it "restarts from data after the delimiter when overflow happens in a chunk containing one" do
+      expect(subject.extract("12345")).to eq([])
+
+      expect { subject.extract("678901\nok\n") }.to raise_error(/input buffer full/)
+
+      expect(subject.extract("ok\n")).to eq(["ok"])
+    end
+
+    it "discards data until the next delimiter after overflowing without one" do
+      expect(subject.extract("12345")).to eq([])
+
+      expect { subject.extract("678901") }.to raise_error(/input buffer full/)
+
+      expect(subject.extract("ignored\nok\n")).to eq(["ok"])
+    end
+  end
 end
