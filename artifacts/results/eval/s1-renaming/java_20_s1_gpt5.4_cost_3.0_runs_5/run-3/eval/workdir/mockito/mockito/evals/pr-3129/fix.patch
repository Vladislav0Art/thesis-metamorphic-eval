diff --git a/src/main/java/org/mockito/plugins/MockitoPluginRegistry.java b/src/main/java/org/mockito/plugins/MockitoPluginRegistry.java
index 651d420b3..792b132cb 100644
--- a/src/main/java/org/mockito/plugins/MockitoPluginRegistry.java
+++ b/src/main/java/org/mockito/plugins/MockitoPluginRegistry.java
@@ -4,6 +4,7 @@
  */
 package org.mockito.plugins;
 
+import org.mockito.MockMakers;
 import org.mockito.Mockito;
 import org.mockito.MockitoFramework;
 
@@ -41,4 +42,26 @@ public interface MockitoPluginRegistry {
      * @since 2.10.0
      */
     MockMaker getInlineMockMaker();
+
+    /**
+     * Returns the mock maker identified by the supplied alias or fully qualified class name.
+     * Unlike {@link #getDefaultPlugin(Class)} and {@link #getInlineMockMaker()}, repeated lookups of the same
+     * mock maker return the same cached instance.
+     * <p>
+     * Supported aliases include {@code null} for the default mock maker and the public constants defined in
+     * {@link MockMakers}, such as {@link MockMakers#INLINE}, {@link MockMakers#PROXY}, and {@link MockMakers#SUBCLASS}.
+     *
+     * @param mockMaker alias or fully qualified mock maker implementation class name
+     * @return the cached mock maker instance
+     */
+    default MockMaker getMockMaker(String mockMaker) {
+        if (mockMaker == null) {
+            return getDefaultPlugin(MockMaker.class);
+        }
+        if (MockMakers.INLINE.equals(mockMaker)) {
+            return getInlineMockMaker();
+        }
+        throw new UnsupportedOperationException(
+                "This MockitoPluginRegistry does not support lookup of mock makers by key: " + mockMaker);
+    }
 }
