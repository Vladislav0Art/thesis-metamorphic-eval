diff --git a/logstash-core/spec/logstash/util/buftok_spec.rb b/logstash-core/spec/logstash/util/buftok_spec.rb
index cccb9c476..856e008ee 100644
--- a/logstash-core/spec/logstash/util/buftok_spec.rb
+++ b/logstash-core/spec/logstash/util/buftok_spec.rb
@@ -43,6 +43,28 @@ describe  FileWatch::BufferedTokenizer  do
     expect(subject.extract("\n\n\n")).to eq(["", "", ""])
   end
 
+  context "with size limit" do
+    subject { FileWatch::BufferedTokenizer.new("\n", 10) }
+
+    it "clears oversized buffered input so processing can restart from the next payload" do
+      expect(subject.extract("12345678")).to eq([])
+
+      expect { subject.extract("901\nok\n") }.to raise_error(Java::JavaLang::IllegalStateException, "input buffer full")
+
+      expect(subject.extract("ok\n")).to eq(["ok"])
+      expect(subject.extract("next\n")).to eq(["next"])
+    end
+
+    it "discards data until the next delimiter after an overflow" do
+      expect(subject.extract("12345678")).to eq([])
+
+      expect { subject.extract("9012") }.to raise_error(Java::JavaLang::IllegalStateException, "input buffer full")
+
+      expect(subject.extract("345")).to eq([])
+      expect(subject.extract("6\nok\n")).to eq(["ok"])
+    end
+  end
+
   context 'with delimiter' do
     subject { FileWatch::BufferedTokenizer.new(delimiter) }
 
