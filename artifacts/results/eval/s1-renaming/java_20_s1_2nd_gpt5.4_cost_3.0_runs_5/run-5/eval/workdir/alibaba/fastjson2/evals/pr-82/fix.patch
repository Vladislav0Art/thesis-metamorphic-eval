+import com.alibaba.fastjson2.JsonMapper;
+
+public class Repro {
+    public static void main(String[] args) {
+        System.out.println("isValidArray([]): " + JsonMapper.isValidArray("[]"));
+        System.out.println("isValidArray([]a): " + JsonMapper.isValidArray("[]a"));
+        System.out.println("isValid({}): " + JsonMapper.isValid("{}"));
