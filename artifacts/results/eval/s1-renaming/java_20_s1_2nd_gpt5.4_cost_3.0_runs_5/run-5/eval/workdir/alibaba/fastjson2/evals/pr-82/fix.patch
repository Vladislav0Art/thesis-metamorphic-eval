+package com.alibaba.fastjson2.issues;
+
+import com.alibaba.fastjson2.JsonMapper;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class IssueArrayObjectValidationTailTest {
+    @Test
+    public void test_isValidArray_with_trailing_chars() {
+        assertTrue(JsonMapper.isValidArray("[]"));
+        assertFalse(JsonMapper.isValidArray("[]a"));
+        assertFalse(JsonMapper.isValidArray("[]1"));
+    }
+
+    @Test
+    public void test_isValid_with_trailing_chars() {
+        assertTrue(JsonMapper.isValid("{}"));
+        assertFalse(JsonMapper.isValid("{}a"));
+        assertFalse(JsonMapper.isValid("{}[]"));
+    }
+}
