+package org.mockitousage;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.Spy;
+import org.mockito.junit.jupiter.MockitoExtension;
+
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+
+@ExtendWith(MockitoExtension.class)
+class GenericSpyRecordTest {
+
+    @Spy
+    private final List<String> genericSpy = List.of("item A", "item B");
+
+    @Spy
+    private ExampleFinalClass exampleFinalClass = new ExampleFinalClass("some value");
+
+    @Test
+    void should_keep_initialized_final_spy_state_when_another_spy_has_generic_type() {
+        assertNotNull(exampleFinalClass.someParameter());
+    }
+
+    private static final class ExampleFinalClass {
+        private final String someParameter;
+
+        private ExampleFinalClass(String someParameter) {
+            this.someParameter = someParameter;
+        }
+
+        private String someParameter() {
+            return someParameter;
+        }
+    }
+}
+
