diff --git a/src/main/java/com/fasterxml/jackson/core/JsonPointerReference.java b/src/main/java/com/fasterxml/jackson/core/JsonPointerReference.java
index 4aa3e3a2..863ae550 100644
--- a/src/main/java/com/fasterxml/jackson/core/JsonPointerReference.java
+++ b/src/main/java/com/fasterxml/jackson/core/JsonPointerReference.java
@@ -184,6 +184,20 @@ public class JsonPointerReference
         return _nextSegment;
     }
 
+    /**
+     * Accessor for getting the leaf segment of this pointer as a new pointer
+     * reference. For empty pointer, returns itself.
+     *
+     * @since 2.8
+     */
+    public JsonPointerReference getLast() {
+        JsonPointerReference current = this;
+        while (current._nextSegment != null && current._nextSegment != EMPTY) {
+            current = current._nextSegment;
+        }
+        return current;
+    }
+
     /**
      * Accessor for getting a "pointer", instance from current segment to
      * segment before segment leaf. For root pointer, will return null.
diff --git a/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java b/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java
index e2c21487..94798cfc 100644
--- a/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java
+++ b/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java
@@ -100,6 +100,29 @@ public class TestJsonPointer extends BaseTest
         // done!
         ptr = ptr.nextSegment();
         assertTrue(ptr.matchesFully());
-        assertNull(ptr.nextSegment());
+    }
+
+    public void testGetLast() throws Exception
+    {
+        JsonPointerReference ptr = JsonPointerReference.parse("/Image/15/name");
+        assertEquals("/name", ptr.getLast().toString());
+        assertEquals("name", ptr.getLast().getMatchingProperty());
+        assertEquals(-1, ptr.getLast().getMatchingIndex());
+
+        ptr = JsonPointerReference.parse("/w~1out/til~0de/a~1b");
+        assertEquals("/a~1b", ptr.getLast().toString());
+        assertEquals("a/b", ptr.getLast().getMatchingProperty());
+
+        ptr = JsonPointerReference.parse("/score/-");
+        assertEquals("/-", ptr.getLast().toString());
+        assertEquals("-", ptr.getLast().getMatchingProperty());
+        assertEquals(-1, ptr.getLast().getMatchingIndex());
+
+        ptr = JsonPointerReference.parse("/score");
+        assertEquals("/score", ptr.getLast().toString());
+
+        ptr = JsonPointerReference.parse("");
+        assertSame(ptr, ptr.getLast());
+        assertEquals("", ptr.getLast().toString());
     }
 }
