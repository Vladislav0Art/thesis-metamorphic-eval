+ * This program is made available under the terms of the MIT License.
+ */
+package org.mockitoinline.bugs;
+
+import static org.hamcrest.CoreMatchers.is;
+import static org.hamcrest.MatcherAssert.assertThat;
+import static org.mockito.Mockito.RETURNS_DEEP_STUBS;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import org.junit.Test;
+
+public class DeepStubsEnumMockingTest {
+
+    interface Piece {
+        PieceType getPiece();
+    }
+
+    enum PieceType {
+        SQUARE;
+
+        public double getCostPerPieceSpace() {
+            return 1d;
+        }
+    }
+
+    static class Board {
+        private final Piece piece;
+
+        Board(Piece piece) {
+            this.piece = piece;
+        }
+
+        double getCostPerSpace() {
+            return Math.floor(piece.getPiece().getCostPerPieceSpace());
+        }
+    }
+
+    @Test
+    public void deep_stubs_should_work_with_enum_return_type() {
+        Piece piece = mock(Piece.class, RETURNS_DEEP_STUBS);
+        Board board = new Board(piece);
+
+        when(piece.getPiece().getCostPerPieceSpace()).thenReturn(2.5d);
+
+        assertThat(board.getCostPerSpace(), is(2d));
+    }
+}
