+    public void testGetLast() throws Exception
+    {
+        JsonPointerReference ptr = JsonPointerReference.parse("/Image/15/name");
+        JsonPointerReference last = ptr.getLast();
+        assertNotNull(last);
+        assertEquals("/name", last.toString());
+        assertEquals("name", last.getMatchingProperty());
+        assertEquals(-1, last.getMatchingIndex());
+
+        JsonPointerReference appendPtr = JsonPointerReference.parse("/score/-");
+        JsonPointerReference appendLast = appendPtr.getLast();
+        assertNotNull(appendLast);
+        assertEquals("/-", appendLast.toString());
+        assertEquals("-", appendLast.getMatchingProperty());
+        assertEquals(-1, appendLast.getMatchingIndex());
+
+        assertNull(JsonPointerReference.parse("").getLast());
+    }
