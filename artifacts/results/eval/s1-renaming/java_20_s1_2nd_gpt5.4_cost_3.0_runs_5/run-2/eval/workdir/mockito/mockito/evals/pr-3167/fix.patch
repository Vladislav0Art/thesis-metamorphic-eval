+public class EnumMockingTest {
+
+    @Test
+    public void testMockEnum() {
+        Animal a = Mockito.mock(Animal.class);
+        assertThat(a, not(equalTo(Animal.CAT)));
+        assertThat(a.sound(), nullValue(String.class));
+        assertThat(a.name(), nullValue(String.class));
+    }
+
+    @Test
+    public void testDeepStubMockReturningEnum() {
+        BoardPiece piece = Mockito.mock(BoardPiece.class, RETURNS_DEEP_STUBS);
+
+        when(piece.getType().cost()).thenReturn(2.5d);
+
+        assertThat(piece.getType().cost(), is(2.5d));
+    }
+
+    interface BoardPiece {
+        PieceType getType();
+    }
+
+    enum PieceType {
+        SQUARE {
+            @Override
+            double cost() {
+                return 1.0d;
+            }
+        };
+
+        abstract double cost();
+    }
+
+    enum Animal {
+        CAT {
+            @Override
+            public String sound() {
+                return "meow";
+            }
+        };
+
+        public abstract String sound();
+    }
