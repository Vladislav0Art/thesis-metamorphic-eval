@@ -76,6 +77,32 @@ public class IllegalTypesCheckTest extends BaseMapTest
         _testIllegalType(BogusApplicationContext.class);
     }
 
+    // // // Tests for [databind#1872]
+    public void testSpringInterfaceType1872() throws Exception
+    {
+        // Spring interface type should NOT cause NPE [databind#1872]
+        // The interface is in org.springframework.* but is not dangerous, so should NOT be blocked
+        // Prior to fix, this would throw NullPointerException because getSuperclass() on an interface returns null
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.enableDefaultTyping(ObjectMapper.DefaultTyping.NON_FINAL, JsonTypeInfo.As.PROPERTY);
+        String clsName = BogusGrantedAuthority.class.getName();
+        String json = aposToQuotes("{'v':['"+clsName+"',{}]}");
+        try {
+            // This may fail (can't instantiate interface), but should NOT throw NPE
+            MAPPER.readValue(json, PolyWrapper.class);
+        } catch (JsonMappingException e) {
+            // Verify it's NOT a security exception (the interface is not dangerous)
+            // and NOT an NPE
+            assertFalse("Should not be caused by NullPointerException",
+                    e.getCause() instanceof NullPointerException);
+            String msg = e.getMessage();
+            if (msg != null) {
+                assertFalse("Should not be blocked as security issue",
+                        msg.contains("prevented for security reasons"));
+            }
+        }
+    }
+
