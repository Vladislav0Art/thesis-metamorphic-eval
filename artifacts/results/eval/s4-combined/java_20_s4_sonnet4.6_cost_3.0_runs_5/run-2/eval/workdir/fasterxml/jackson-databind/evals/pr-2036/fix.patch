+++ b/src/test/java/com/fasterxml/jackson/databind/jsontype/UseBaseTypeAsDefaultImplTest.java
@@ -0,0 +1,61 @@
+package com.fasterxml.jackson.databind.jsontype;
+
+import com.fasterxml.jackson.annotation.JsonTypeInfo;
+import com.fasterxml.jackson.databind.BaseMapTest;
+import com.fasterxml.jackson.databind.MapperFeature;
+import com.fasterxml.jackson.databind.ObjectMapper;
+
+/**
+ * Tests for {@link MapperFeature#USE_BASE_TYPE_AS_DEFAULT_IMPL}.
+ */
+public class UseBaseTypeAsDefaultImplTest extends BaseMapTest
+{
+    @JsonTypeInfo(use = JsonTypeInfo.Id.MINIMAL_CLASS, include = JsonTypeInfo.As.PROPERTY, property = "type")
+    public interface MyInterface {
+        String getName();
+        void setName(String name);
+    }
+
+    public static class MyClass implements MyInterface {
+        private String name;
+        @Override
+        public String getName() { return name; }
+        @Override
+        public void setName(String name) { this.name = name; }
+    }
+
+    // Test that with USE_BASE_TYPE_AS_DEFAULT_IMPL enabled, reading a concrete class
+    // without type info works correctly
+    public void testUseBaseTypeAsDefaultImpl() throws Exception {
+        ObjectMapper mapper = jsonMapperBuilder()
+                .enable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL)
+                .build();
+
+        // JSON without type property
+        String json = "{\"name\":\"test\"}";
+        MyClass result = mapper.readValue(json, MyClass.class);
+        assertNotNull(result);
+        assertEquals("test", result.getName());
+    }
+
+    // Test that without USE_BASE_TYPE_AS_DEFAULT_IMPL enabled, reading fails
+    public void testWithoutUseBaseTypeAsDefaultImplFails() throws Exception {
+        ObjectMapper mapper = jsonMapperBuilder()
+                .disable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL)
+                .build();
+
+        // JSON without type property - should fail
+        String json = "{\"name\":\"test\"}";
+        try {
+            mapper.readValue(json, MyClass.class);
+            fail("Should have thrown an exception");
+        } catch (Exception e) {
+            // Expected
+        }
+    }
+
+    // Test that the feature is disabled by default
+    public void testFeatureDisabledByDefault() throws Exception {
+        assertFalse(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL.enabledByDefault());
+    }
+}
