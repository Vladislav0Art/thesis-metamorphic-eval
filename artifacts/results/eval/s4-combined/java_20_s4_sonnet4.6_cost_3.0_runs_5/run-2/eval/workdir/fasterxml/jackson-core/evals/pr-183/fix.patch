diff --git a/TestReproduction.java b/TestReproduction.java
new file mode 100644
index 00000000..c599719a
--- /dev/null
+++ b/TestReproduction.java
@@ -0,0 +1,23 @@
+import com.fasterxml.jackson.core.util.SegmentedTextBuffer;
+import com.fasterxml.jackson.core.util.BufferRecycler;
+
+public class TestReproduction {
+    public static void main(String[] args) {
+        SegmentedTextBuffer buffer = new SegmentedTextBuffer(new BufferRecycler());
+        buffer.resetToEmpty();
+        char[] first = buffer.getTextBuffer();
+        System.out.println("First getTextBuffer() result: " + (first == null ? "null" : "array of length " + first.length));
+        String s = buffer.getContentsAsString();
+        System.out.println("getContentsAsString() result: \"" + s + "\"");
+        char[] second = buffer.getTextBuffer();
+        System.out.println("Second getTextBuffer() result: " + (second == null ? "null" : "array of length " + second.length));
+        
+        if (first == null || second == null) {
+            System.out.println("FAIL: getTextBuffer() returned null");
+        } else if (first.length != second.length) {
+            System.out.println("FAIL: inconsistent results: " + first.length + " vs " + second.length);
+        } else {
+            System.out.println("PASS: consistent results");
+        }
+    }
+}
