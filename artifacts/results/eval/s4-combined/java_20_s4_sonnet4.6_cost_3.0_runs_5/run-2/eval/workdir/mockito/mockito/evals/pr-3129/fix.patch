+
+    /**
+     * Returns a mock maker by its type name or alias, reusing a cached instance if available.
+     * Unlike {@link #getInlineMockMaker()}, this method returns the same shared instance for the
+     * same mock maker name, so that Mockito and framework integrations (e.g. Spock) share the
+     * same mock maker state and do not conflict when mocking the same classes.
+     *
+     * @param mockMakerNameOrAlias the fully-qualified class name or built-in alias (e.g.
+     *     {@code "mock-maker-inline"}, {@code "mock-maker-subclass"}, {@code "mock-maker-proxy"})
+     *     of the desired {@link MockMaker}. Pass {@code null} to obtain the default mock maker.
+     * @return the shared mock maker instance
+     * @since 5.14.0
+     */
+    MockMaker getMockMaker(String mockMakerNameOrAlias);
 }
