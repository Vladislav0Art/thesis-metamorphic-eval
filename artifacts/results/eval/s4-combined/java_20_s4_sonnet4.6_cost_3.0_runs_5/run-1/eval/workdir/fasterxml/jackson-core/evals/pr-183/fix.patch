+    // Test for SegmentedTextBuffer#getTextBuffer consistency after resetToEmpty
+    public void testGetTextBufferConsistency()
+    {
+        SegmentedTextBuffer buffer = new SegmentedTextBuffer(new BufferRecycler());
+        buffer.resetToEmpty();
+        char[] first = buffer.getTextBuffer(); // should return [] (EMPTY_CHARS), not null
+        assertNotNull(first);
+        assertEquals(0, first.length);
+        buffer.getContentsAsString(); // returns empty string ""
+        char[] second = buffer.getTextBuffer(); // should also return []
+        assertNotNull(second);
+        assertEquals(0, second.length);
+    }
