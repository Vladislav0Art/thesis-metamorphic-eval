+    // // // Tests for Spring interface NPE fix
+    public void testSpringInterfaceTypeDoesNotCauseNPE() throws Exception
+    {
+        // should not cause NPE when validating a Spring interface type
+        // (interfaces have null superclass, so loop must handle that)
+        ObjectMapper mapper = objectMapper();
+        mapper.enableDefaultTyping(ObjectMapper.DefaultTyping.NON_FINAL, JsonTypeInfo.As.PROPERTY);
+        String json = aposToQuotes(
+            "{'@class':'org.springframework.jacksontest.BogusGrantedAuthority'}"
+        );
+        // Should either succeed or throw a JsonMappingException, but NOT NullPointerException
+        try {
+            mapper.readValue(json, Object.class);
+        } catch (JsonMappingException e) {
+            // this is acceptable - but not NPE
+        }
+    }
