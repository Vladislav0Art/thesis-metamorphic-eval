diff --git a/build.gradle b/build.gradle
index 7e4c7a868..cb98b5740 100644
--- a/build.gradle
+++ b/build.gradle
@@ -861,6 +861,17 @@ tasks.register("copyJdk", Copy) {
     // CLI project properties: -Pjdk_bundle_os=[windows|linux|darwin] -Pjdk_arch=[arm64|x86_64]
     doLast {
         System.out.println "Download location is ${project.ext.jdkDownloadLocation}, Decompressing ${project.ext.jdkDirectory} to \"${project.ext.jdkBundlingDirectory}\""
+        // Create VERSION file in the bundled JDK directory from jdk/release
+        def releaseFile = new File("${project.ext.jdkBundlingDirectory}/release")
+        if (releaseFile.exists()) {
+            def versionLine = releaseFile.readLines().find { it.startsWith("IMPLEMENTOR_VERSION=") }
+            if (versionLine) {
+                def version = versionLine.split("=")[1].replaceAll('"', '').trim()
+                def versionFile = new File("${project.ext.jdkBundlingDirectory}/VERSION")
+                versionFile.text = version
+                System.out.println "Created VERSION file with content: ${version}"
+            }
+        }
     }
 }
 
