diff --git a/src/test/java/com/fasterxml/jackson/databind/jsontype/UseBaseTypeAsDefaultImplTest.java b/src/test/java/com/fasterxml/jackson/databind/jsontype/UseBaseTypeAsDefaultImplTest.java
new file mode 100644
index 000000000..f82fff16e
--- /dev/null
+++ b/src/test/java/com/fasterxml/jackson/databind/jsontype/UseBaseTypeAsDefaultImplTest.java
@@ -0,0 +1,65 @@
+package com.fasterxml.jackson.databind.jsontype;
+
+import com.fasterxml.jackson.annotation.JsonTypeInfo;
+import com.fasterxml.jackson.databind.BaseMapTest;
+import com.fasterxml.jackson.databind.MapperFeature;
+import com.fasterxml.jackson.databind.ObjectMapper;
+
+/**
+ * Tests for {@link MapperFeature#USE_BASE_TYPE_AS_DEFAULT_IMPL}.
+ */
+public class UseBaseTypeAsDefaultImplTest extends BaseMapTest
+{
+    @JsonTypeInfo(use = JsonTypeInfo.Id.MINIMAL_CLASS, include = JsonTypeInfo.As.PROPERTY, property = "type")
+    public interface MyInterface {
+        String getName();
+        void setName(String name);
+    }
+
+    public static class MyClass implements MyInterface {
+        private String name;
+
+        @Override
+        public String getName() {
+            return name;
+        }
+
+        @Override
+        public void setName(String name) {
+            this.name = name;
+        }
+    }
+
+    // Test that deserialization works with type info present (baseline)
+    public void testWithTypeInfo() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.enable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL);
+        String json = "{\"name\":\"test\",\"type\":\".UseBaseTypeAsDefaultImplTest$MyClass\"}";
+        MyInterface result = mapper.readValue(json, MyInterface.class);
+        assertNotNull(result);
+        assertEquals("test", result.getName());
+    }
+
+    // Test that deserialization of concrete class works without type info when feature enabled
+    public void testConcreteClassWithoutTypeInfoFeatureEnabled() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.enable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL);
+        String json = "{\"name\":\"test\"}";
+        MyClass result = mapper.readValue(json, MyClass.class);
+        assertNotNull(result);
+        assertEquals("test", result.getName());
+    }
+
+    // Test that deserialization of concrete class fails without type info when feature disabled
+    public void testConcreteClassWithoutTypeInfoFeatureDisabled() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.disable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL);
+        String json = "{\"name\":\"test\"}";
+        try {
+            mapper.readValue(json, MyClass.class);
+            fail("Expected exception due to missing type id");
+        } catch (Exception e) {
+            // expected
+        }
+    }
+}
