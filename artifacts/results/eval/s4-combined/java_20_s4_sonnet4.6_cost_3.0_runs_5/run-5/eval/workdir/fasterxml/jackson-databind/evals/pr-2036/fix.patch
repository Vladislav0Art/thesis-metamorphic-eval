-    IGNORE_MERGE_FOR_UNMERGEABLE(true)
+    IGNORE_MERGE_FOR_UNMERGEABLE(true),
+
+    /**
+     * Feature that determines whether the declared base type of a polymorphic value
+     * is used as the "default implementation" (see
+     * {@link com.fasterxml.jackson.annotation.JsonTypeInfo#defaultImpl}) if no
+     * explicit default implementation is specified, and no type information is
+     * available. This is useful when the declared type is a concrete class and you
+     * want deserialization to succeed even when the type identifier is not present
+     * in the JSON.
+     *<p>
+     * Feature is disabled by default.
+     *
+     * @since 2.10
+     */
+    USE_BASE_TYPE_AS_DEFAULT_IMPL(false)
 
     ;
 
