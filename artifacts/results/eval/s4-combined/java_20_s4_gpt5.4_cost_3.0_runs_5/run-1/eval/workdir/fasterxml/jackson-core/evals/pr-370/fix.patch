+  @Test
+  public void testObjectTrailingCommaWithNextName() throws Exception {
+    String json = "{\"a\": true, \"b\": false,}";
+
+    JsonParser p = createParser(factory, mode, json);
+
+    assertEquals(JsonToken.START_OBJECT, p.nextToken());
+
+    if (mode == MODE_READER) {
+      JsonParserFromReader readerParser = (JsonParserFromReader) p;
+
+      assertEquals("a", readerParser.nextName());
+      assertToken(JsonToken.VALUE_TRUE, p.nextToken());
+
+      assertEquals("b", readerParser.nextName());
+      assertToken(JsonToken.VALUE_FALSE, p.nextToken());
+
+      if (features.contains(Feature.ALLOW_TRAILING_COMMA)) {
+        assertNull(readerParser.nextName());
+        assertToken(JsonToken.END_OBJECT, p.getCurrentToken());
+        assertEnd(p);
+      } else {
+        try {
+          readerParser.nextName();
+          fail("No exception thrown");
+        } catch (Exception e) {
+          verifyException(e, "Unexpected character ('}' (code 125))");
+        }
+      }
+    } else {
+      assertToken(JsonToken.FIELD_NAME, p.nextToken());
+      assertEquals("a", p.getText());
+      assertToken(JsonToken.VALUE_TRUE, p.nextToken());
+
+      assertToken(JsonToken.FIELD_NAME, p.nextToken());
+      assertEquals("b", p.getText());
+      assertToken(JsonToken.VALUE_FALSE, p.nextToken());
+
+      if (features.contains(Feature.ALLOW_TRAILING_COMMA)) {
+        assertToken(JsonToken.END_OBJECT, p.nextToken());
+        assertEnd(p);
+      } else {
+        assertUnexpected(p, '}');
+      }
+    }
+    p.close();
+  }
 
