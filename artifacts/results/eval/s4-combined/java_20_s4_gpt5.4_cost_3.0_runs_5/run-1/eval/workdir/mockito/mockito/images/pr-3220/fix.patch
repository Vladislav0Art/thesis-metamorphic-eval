 package org.mockito.quality;
 
+import org.mockito.NotExtensible;
+import org.mockito.configuration.MockCreationConfiguration;
+import org.mockito.plugins.enforcers.DoNotMockTypeEnforcer;
+
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+
 /**
  * Enforcer that is applied to every type in the type hierarchy of the class-to-be-mocked.
  */
-public interface DoNotMockRuleEnforcer {
+public interface DoNotMockRuleEnforcer extends DoNotMockTypeEnforcer {
 
     /**
-     * If this type is allowed to be mocked. Return an empty optional if the enforcer allows
+     * Check whether this type is allowed to be mocked. Return {@code null} if the enforcer allows
      * this type to be mocked. Return a message if there is a reason this type can not be mocked.
-     *
-     * Note that Mockito performs traversal of the type hierarchy. Implementations of this class
-     * should therefore not perform type traversal themselves but rely on Mockito.
+     * <p>
+     * Note that traversal of the type hierarchy is performed externally to this method.
+     * Implementations of it should therefore not perform type traversal themselves.
      *
      * @param targetClass The type to check
-     * @return Optional message if this type can not be mocked, or an empty optional if type can be mocked
+     * @return Optional message if this type can not be mocked, or {@code null} otherwise
+     * @see #validateTypeForDoNotMockViolation(MockCreationConfiguration)
      */
     String validateTypeForDoNotMockViolation(Class<?> targetClass);
+
+    /**
+     * Check whether this type is allowed to be mocked. Return {@code null} if the enforcer allows
+     * this type to be mocked. Return a message if there is a reason this type can not be mocked.
+     * <p>
+     * The default implementation traverses the class hierarchy of the type to be mocked and
+     * checks it against {@link #validateTypeForDoNotMockViolation(Class)}. If any types fails
+     * the validation, the traversal is interrupted and the error message is returned.
+     *
+     * @param mockCreationConfig The mock creation settings
+     * @return Optional message if this type can not be mocked, or {@code null} otherwise
+     * @since 5.9.0
+     */
+    @Override
+    default String validateTypeForDoNotMockViolation(MockCreationConfiguration<?> mockCreationConfig) {
+        String alertMessage = checkDoNotMockAnnotationRecursivelyForType(mockCreationConfig.getTypeToMock());
+        if (alertMessage != null) {
+            return alertMessage;
+        }
+
+        for (Class<?> targetClass : mockCreationConfig.getExtraInterfaces()) {
+            alertMessage = checkDoNotMockAnnotationRecursivelyForType(targetClass);
+            if (alertMessage != null) {
+                return alertMessage;
+            }
+        }
+
+        return null;
+    }
+
+    private String checkDoNotMockAnnotationRecursivelyForType(Class<?> targetType) {
+        // Object and interfaces do not have a super class
+        if (targetType == null) {
+            return null;
+        }
+
+        if (CacheStore.ALLOWED_MOCK_TYPES.contains(targetType)) {
+            return null;
+        }
+
+        String alertMessage = validateTypeForDoNotMockViolation(targetType);
+        if (alertMessage != null) {
+            return alertMessage;
+        }
+
+        alertMessage = checkDoNotMockAnnotationRecursivelyForType(targetType.getSuperclass());
+        if (alertMessage != null) {
+            return alertMessage;
+        }
+
+        for (Class<?> targetClass : targetType.getInterfaces()) {
+            alertMessage = checkDoNotMockAnnotationRecursivelyForType(targetClass);
+            if (alertMessage != null) {
+                return alertMessage;
+            }
+        }
+
+        CacheStore.ALLOWED_MOCK_TYPES.add(targetType);
+        return null;
+    }
+
+    /**
+     * Static cache for types that are known to be mockable and
+     * thus may be skipped while traversing the class hierarchy.
+     */
+    @NotExtensible
+    class CacheStore {
+        private static final Set<Class<?>> ALLOWED_MOCK_TYPES = ConcurrentHashMap.newKeySet();
+    }
 }
