+package org.logstash.common;
+
+import org.jruby.RubyArray;
+
+import org.jruby.runtime.ThreadContext;
+import org.junit.Test;
+import org.logstash.RubyTestBase;
+import org.logstash.RubyUtil;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.fail;
+
+public class BufferedTokenizerExtTest extends RubyTestBase {
+
+    @Test
+    @SuppressWarnings("rawtypes")
+    public void discardsOversizedPayloadThroughNextDelimiterAndResumes() {
+        final ThreadContext context = RubyUtil.RUBY.getCurrentContext();
+        final BufferedTokenizerExt tokenizer =
+            new BufferedTokenizerExt(RubyUtil.RUBY, RubyUtil.BUFFERED_TOKENIZER);
+
+        tokenizer.init(
+            context,
+            new org.jruby.runtime.builtin.IRubyObject[] {
+                RubyUtil.RUBY.newString("\n"),
+                RubyUtil.RUBY.newFixnum(100_000)
+            }
+        );
+
+        final RubyArray first = tokenizer.extract(
+            context,
+            RubyUtil.RUBY.newString("{\"a\":\"" + repeat("a", 89_994))
+        );
+        assertEquals(0, first.size());
+
+        try {
+            tokenizer.extract(
+                context,
+                RubyUtil.RUBY.newString(repeat("a", 15_007) + "\"}\n{\"b\":\"bbbb\"}\n")
+            );
+            fail("expected input buffer full");
+        } catch (IllegalStateException e) {
+            assertEquals("input buffer full", e.getMessage());
+        }
+
+        final RubyArray resumed = tokenizer.extract(
+            context,
+            RubyUtil.RUBY.newString("{\"c\":\"cccc\"}\n")
+        );
+
+        assertEquals(2, resumed.size());
+        assertEquals("{\"b\":\"bbbb\"}", resumed.entry(0).asJavaString());
+        assertEquals("{\"c\":\"cccc\"}", resumed.entry(1).asJavaString());
+    }
+
+    private static String repeat(final String value, final int count) {
+        return new String(new char[count]).replace("\0", value);
+    }
+}
