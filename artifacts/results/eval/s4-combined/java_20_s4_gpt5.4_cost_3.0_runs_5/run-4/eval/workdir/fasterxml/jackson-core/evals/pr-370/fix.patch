+  @Test
+  public void testObjectTrailingCommaWithNextName() throws Exception {
+    String json = "{\"a\": true,}";
+
+    JsonParser p = createParser(factory, mode, json);
+
+    assertEquals(JsonToken.START_OBJECT, p.nextToken());
+
+    assertEquals("a", p.nextName());
+    assertToken(JsonToken.VALUE_TRUE, p.nextToken());
+
+    if (features.contains(Feature.ALLOW_TRAILING_COMMA)) {
+      assertNull(p.nextName());
+      assertToken(JsonToken.END_OBJECT, p.getCurrentToken());
+      assertEnd(p);
+    } else {
+      try {
+        p.nextName();
+        fail("No exception thrown");
+      } catch (Exception e) {
+        verifyException(e, String.format("Unexpected character ('%s' (code %d))", '}', (int) '}'));
+      }
+    }
+    p.close();
+  }
