     public JsonPointerPath getHead() {
         return _headSegment;
+    }
+
+    /**
+     * Accessor for getting a "pointer" containing only the terminal segment.
+     * For root pointer, will return null.
+     */
+    public JsonPointerPath getLastSegment() {
+        if (matchesExactly()) {
+            return null;
+        }
+        JsonPointerPath current = this;
+        while (!current._nextSegment.matchesExactly()) {
+            current = current._nextSegment;
+        }
+        return current;
     }@Override public boolean equals(Object other) {
         if (other == this) return true;
