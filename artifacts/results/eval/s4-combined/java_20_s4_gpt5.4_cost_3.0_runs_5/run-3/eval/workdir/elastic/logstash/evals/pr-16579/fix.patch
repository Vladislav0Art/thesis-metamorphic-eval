   end
+
+  context 'with size limit' do
+    subject { FileWatch::BufferedTokenizer.new("\n", 5) }
+
+    it "discards the oversized token through the next delimiter when restarted" do
+      expect(subject.extract("1234")).to eq([])
+      expect { subject.extract("56\nok\n") }.to raise_error(/input buffer full/)
