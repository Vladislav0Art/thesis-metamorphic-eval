diff --git a/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java b/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java
index 7874c474..39424e88 100644
--- a/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java
+++ b/src/test/java/com/fasterxml/jackson/core/TestJsonPointer.java
@@ -102,4 +102,30 @@ public class TestJsonPointer extends BaseTest
         assertTrue(ptr.matchesExactly());
         assertNull(ptr.nextSegment());
     }
+
+    public void testGetLastSegment() throws Exception
+    {
+        JsonPointerPath ptr = JsonPointerPath.parse("/Image/15/name");
+        JsonPointerPath last = ptr.getLastSegment();
+        assertNotNull(last);
+        assertEquals("/name", last.toString());
+        assertEquals("name", last.getMatchingProperty());
+        assertEquals("", last.getHead().toString());
+        assertSame(last, last.getLastSegment());
+
+        ptr = JsonPointerPath.parse("/score/-");
+        last = ptr.getLastSegment();
+        assertNotNull(last);
+        assertEquals("/-", last.toString());
+        assertEquals("-", last.getMatchingProperty());
+        assertEquals(-1, last.getMatchingIndex());
+
+        ptr = JsonPointerPath.parse("/score");
+        last = ptr.getLastSegment();
+        assertNotNull(last);
+        assertEquals("/score", last.toString());
+        assertEquals("score", last.getMatchingProperty());
+
+        assertNull(JsonPointerPath.parse("").getLastSegment());
+    }
