@@ -474,7 +474,27 @@ public enum MapperFeature implements ConfigFeature
      *
      * @since 2.9
      */
-    IGNORE_MERGE_FOR_UNMERGEABLE(true)
+    IGNORE_MERGE_FOR_UNMERGEABLE(true),
+
+    /**
+     * Feature that determines whether the declared base type of a polymorphic value
+     * is used as the "default implementation" when no type identifier is present in
+     * the JSON, unless a specific defaultImpl has been set in the annotation.
+     *<p>
+     * When enabled, if no type id (property in the JSON) is found when deserializing
+     * a polymorphic type, Jackson will try to use the declared base type as default
+     * implementation. This is useful for cases like:
+     * <pre>
+     * objectMapper.readValue(jsonWithoutTypeId, ConcreteClass.class);
+     * </pre>
+     * where <code>ConcreteClass</code> has a type annotation (inherited from an interface
+     * or superclass), but the JSON data does not include the type id property.
+     *<p>
+     * Feature is disabled by default.
+     *
+     * @since 2.10
+     */
+    USE_BASE_TYPE_AS_DEFAULT_IMPL(false)
 
     ;
 
