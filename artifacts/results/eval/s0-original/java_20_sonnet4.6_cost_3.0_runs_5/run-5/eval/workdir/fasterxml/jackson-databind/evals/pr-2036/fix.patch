diff --git a/src/test/java/com/fasterxml/jackson/databind/jsontype/UseBaseTypeAsDefaultImplTest.java b/src/test/java/com/fasterxml/jackson/databind/jsontype/UseBaseTypeAsDefaultImplTest.java
new file mode 100644
index 000000000..9a8b14932
--- /dev/null
+++ b/src/test/java/com/fasterxml/jackson/databind/jsontype/UseBaseTypeAsDefaultImplTest.java
@@ -0,0 +1,65 @@
+package com.fasterxml.jackson.databind.jsontype;
+
+import com.fasterxml.jackson.annotation.JsonTypeInfo;
+import com.fasterxml.jackson.databind.*;
+import junit.framework.TestCase;
+
+public class UseBaseTypeAsDefaultImplTest extends TestCase {
+
+    @JsonTypeInfo(use = JsonTypeInfo.Id.MINIMAL_CLASS, include = JsonTypeInfo.As.PROPERTY, property = "type")
+    public interface MyInterface {
+        String getName();
+        void setName(String name);
+    }
+
+    public static class MyClass implements MyInterface {
+        private String name;
+        public String getName() { return name; }
+        public void setName(String name) { this.name = name; }
+    }
+
+    // Test 1: without the feature enabled, missing type id should fail
+    public void testWithoutFeatureFails() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        // Disable the feature to ensure it fails
+        mapper.disable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL);
+        String jsonWithoutTypeId = "{\"name\":\"test\"}";
+        try {
+            mapper.readValue(jsonWithoutTypeId, MyClass.class);
+            fail("Expected exception due to missing type id");
+        } catch (Exception e) {
+            // expected
+        }
+    }
+
+    // Test 2: with the feature enabled, missing type id should use base type as default impl
+    public void testWithFeatureSucceeds() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.enable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL);
+        String jsonWithoutTypeId = "{\"name\":\"test\"}";
+        MyClass result = mapper.readValue(jsonWithoutTypeId, MyClass.class);
+        assertNotNull(result);
+        assertEquals("test", result.getName());
+        System.out.println("testWithFeatureSucceeds passed: name=" + result.getName());
+    }
+
+    // Test 3: with the feature enabled, JSON with type id should still work
+    public void testWithFeatureAndTypeIdSucceeds() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.enable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL);
+        String jsonWithTypeId = "{\"name\":\"test\",\"type\":\".UseBaseTypeAsDefaultImplTest$MyClass\"}";
+        MyInterface result = mapper.readValue(jsonWithTypeId, MyInterface.class);
+        assertNotNull(result);
+        assertEquals("test", result.getName());
+        System.out.println("testWithFeatureAndTypeIdSucceeds passed: name=" + result.getName());
+    }
+
+    public static void main(String[] args) throws Exception {
+        UseBaseTypeAsDefaultImplTest test = new UseBaseTypeAsDefaultImplTest();
+        test.testWithoutFeatureFails();
+        System.out.println("testWithoutFeatureFails passed");
+        test.testWithFeatureSucceeds();
+        test.testWithFeatureAndTypeIdSucceeds();
+        System.out.println("All tests passed!");
+    }
+}
