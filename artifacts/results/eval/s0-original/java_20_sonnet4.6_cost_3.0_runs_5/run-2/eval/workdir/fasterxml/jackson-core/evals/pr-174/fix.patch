+    /**
+     * Method that returns the last path element of this pointer, if it
+     * has any: if not (this pointer is empty), will return null.
+     * For example, for "/a/b/c" this would return a pointer
+     * for "/c".
+     *<p>
+     * This is a method that may be useful for handling JSON Patch
+     * operations that operate on the last element of an array.
+     *
+     * @return Last path element of this pointer, if any; null if none (this
+     *    pointer refers to root)
+     *
+     * @since 2.5
+     */
+    public JsonPointer last() {
+        JsonPointer current = this;
+        if (current == EMPTY) {
+            return null;
+        }
+        JsonPointer next;
+        while ((next = current._nextSegment) != EMPTY) {
+            current = next;
+        }
+        return current;
+    }
