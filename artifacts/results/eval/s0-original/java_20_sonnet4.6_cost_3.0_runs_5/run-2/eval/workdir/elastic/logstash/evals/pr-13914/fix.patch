+get_bundled_jdk_version() {
+  OS_NAME="$(uname -s)"
+  if [ $OS_NAME = "Darwin" ]; then
+    JDK_VERSION_FILE="${LOGSTASH_HOME}/jdk.app/VERSION"
+  else
+    JDK_VERSION_FILE="${LOGSTASH_HOME}/jdk/VERSION"
+  fi
+  if [ -f "${JDK_VERSION_FILE}" ]; then
+    BUNDLED_JDK_VERSION="$(cat ${JDK_VERSION_FILE})"
+  fi
+}
+
