--- /dev/null
+++ b/src/test/java/com/fasterxml/jackson/databind/jsontype/UseBaseTypeAsDefaultImplTest.java
@@ -0,0 +1,60 @@
+package com.fasterxml.jackson.databind.jsontype;
+
+import com.fasterxml.jackson.annotation.JsonTypeInfo;
+import com.fasterxml.jackson.databind.BaseMapTest;
+import com.fasterxml.jackson.databind.MapperFeature;
+import com.fasterxml.jackson.databind.ObjectMapper;
+
+/**
+ * Tests for {@link MapperFeature#USE_BASE_TYPE_AS_DEFAULT_IMPL}.
+ */
+public class UseBaseTypeAsDefaultImplTest extends BaseMapTest
+{
+    @JsonTypeInfo(use = JsonTypeInfo.Id.MINIMAL_CLASS, include = JsonTypeInfo.As.PROPERTY, property = "type")
+    public interface MyInterface {
+        String getName();
+        void setName(String name);
+    }
+
+    public static class MyClass implements MyInterface {
+        private String name;
+        @Override
+        public String getName() { return name; }
+        @Override
+        public void setName(String name) { this.name = name; }
+    }
+
+    // Test: without feature, readValue with concrete type should fail when type property missing
+    public void testWithoutFeature() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        // With feature disabled (default), this should throw
+        try {
+            mapper.readValue("{\"name\":\"test\"}", MyClass.class);
+            fail("Should have thrown an exception due to missing type property");
+        } catch (Exception e) {
+            // expected
+        }
+    }
+
+    // Test: with feature enabled, readValue with concrete type should work even when type property missing
+    public void testWithFeature() throws Exception {
+        ObjectMapper mapper = new ObjectMapper()
+                .enable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL);
+
+        MyInterface result = mapper.readValue("{\"name\":\"testName\"}", MyClass.class);
+        assertNotNull(result);
+        assertEquals("testName", result.getName());
+        assertTrue(result instanceof MyClass);
+    }
+
+    // Test: with feature enabled, explicit type property should still work
+    public void testWithFeatureAndExplicitType() throws Exception {
+        ObjectMapper mapper = new ObjectMapper()
+                .enable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL);
+
+        MyInterface result = mapper.readValue("{\"name\":\"testName\",\"type\":\".UseBaseTypeAsDefaultImplTest$MyClass\"}", MyInterface.class);
+        assertNotNull(result);
+        assertEquals("testName", result.getName());
+        assertTrue(result instanceof MyClass);
+    }
+}
