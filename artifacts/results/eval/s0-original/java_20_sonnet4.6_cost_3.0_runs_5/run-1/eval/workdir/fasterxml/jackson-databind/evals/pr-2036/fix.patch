-    IGNORE_MERGE_FOR_UNMERGEABLE(true)
+    IGNORE_MERGE_FOR_UNMERGEABLE(true),
+
+    /**
+     * Feature that determines whether the declared base type of a polymorphic value
+     * is to be used as the "default implementation" if no type information is available.
+     * This means that if a type is declared {@code @JsonTypeInfo} but JSON has no type
+     * info, the base type (declared type of the property or, if no declared type is
+     * available, the type requested by caller) will be used as the target type.
+     *<p>
+     * Feature is disabled by default (for backwards compatibility).
+     *
+     * @since 2.10
+     */
+    USE_BASE_TYPE_AS_DEFAULT_IMPL(false)
 
     ;
 
