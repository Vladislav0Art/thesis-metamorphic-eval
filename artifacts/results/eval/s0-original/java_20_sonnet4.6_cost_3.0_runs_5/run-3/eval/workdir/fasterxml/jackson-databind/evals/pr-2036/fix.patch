--- /dev/null
+++ b/src/test/java/com/fasterxml/jackson/databind/jsontype/UseBaseTypeAsDefaultImplTest.java
@@ -0,0 +1,61 @@
+package com.fasterxml.jackson.databind.jsontype;
+
+import com.fasterxml.jackson.annotation.JsonTypeInfo;
+import com.fasterxml.jackson.databind.BaseMapTest;
+import com.fasterxml.jackson.databind.MapperFeature;
+import com.fasterxml.jackson.databind.ObjectMapper;
+
+/**
+ * Tests for {@link com.fasterxml.jackson.databind.MapperFeature#USE_BASE_TYPE_AS_DEFAULT_IMPL}.
+ */
+public class UseBaseTypeAsDefaultImplTest extends BaseMapTest
+{
+    @JsonTypeInfo(use = JsonTypeInfo.Id.MINIMAL_CLASS, include = JsonTypeInfo.As.PROPERTY, property = "type")
+    interface MyInterface {
+        String getName();
+        void setName(String name);
+    }
+
+    static class MyClass implements MyInterface {
+        private String name;
+
+        @Override
+        public String getName() {
+            return name;
+        }
+
+        @Override
+        public void setName(String name) {
+            this.name = name;
+        }
+    }
+
+    // Test that reading a JSON without type info into a concrete class works
+    // when USE_BASE_TYPE_AS_DEFAULT_IMPL is enabled
+    public void testUseBaseTypeAsDefaultImpl() throws Exception
+    {
+        final String json = "{\"name\":\"test\"}";
+
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.enable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL);
+
+        MyClass result = mapper.readValue(json, MyClass.class);
+        assertNotNull(result);
+        assertEquals("test", result.getName());
+    }
+
+    // Test that without the feature, the default behavior (failure) is preserved
+    public void testWithoutFeatureStillFails() throws Exception
+    {
+        final String json = "{\"name\":\"test\"}";
+
+        ObjectMapper mapper = new ObjectMapper();
+        // feature NOT enabled
+        try {
+            mapper.readValue(json, MyClass.class);
+            fail("Should have thrown exception due to missing type info");
+        } catch (Exception e) {
+            // expected
+        }
+    }
+}
