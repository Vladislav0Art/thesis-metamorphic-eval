+    // // // Tests for [databind#1980]
+    public void testSpringInterface1980() throws Exception
+    {
+        // Spring interfaces that don't match blocked patterns should not cause NPE
+        // (they also should not be blocked as "illegal types")
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.enableDefaultTyping(ObjectMapper.DefaultTyping.NON_FINAL);
+        String json = aposToQuotes("{'v':['org.springframework.jacksontest.BogusInterface','/tmp/foobar.txt']}");
+        try {
+            mapper.readValue(json, PolyWrapper.class);
+            fail("Should not pass");
+        } catch (JsonMappingException e) {
+            // Should NOT be NPE, and should NOT be a "security" exception
+            // (since BogusInterface is not in the blocked list)
+            // Just verify it's not NPE
+            if (e.getCause() instanceof NullPointerException) {
+                fail("Should not throw NullPointerException for Spring interface");
+            }
+        }
+    }
