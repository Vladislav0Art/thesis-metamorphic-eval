diff --git a/src/main/java/com/fasterxml/jackson/core/JsonPointer.java b/src/main/java/com/fasterxml/jackson/core/JsonPointer.java
index ff251034..7318a264 100644
--- a/src/main/java/com/fasterxml/jackson/core/JsonPointer.java
+++ b/src/main/java/com/fasterxml/jackson/core/JsonPointer.java
@@ -194,6 +194,26 @@ public class JsonPointer
         return _headSegment;
     }
 
+    /**
+     * Accessor for getting the last segment of this pointer. For example,
+     * for pointer "/Image/15/name", this would return the pointer "/name".
+     * For pointer "/score/-", this would return "/-".
+     * For empty pointer (matching current node), returns null.
+     *
+     * @since 2.5
+     */
+    public JsonPointer last() {
+        JsonPointer current = this;
+        if (current.matches()) {
+            return null;
+        }
+        JsonPointer next;
+        while ((next = current.tail()) != null && !next.matches()) {
+            current = next;
+        }
+        return current;
+    }
+
