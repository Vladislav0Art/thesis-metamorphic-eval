@@ -861,6 +861,15 @@ tasks.register("copyJdk", Copy) {
     // CLI project properties: -Pjdk_bundle_os=[windows|linux|darwin] -Pjdk_arch=[arm64|x86_64]
     doLast {
         System.out.println "Download location is ${project.ext.jdkDownloadLocation}, Decompressing ${project.ext.jdkDirectory} to \"${project.ext.jdkBundlingDirectory}\""
+        // Create a VERSION file from the jdk/release file
+        def releaseFile = new File("${project.ext.jdkBundlingDirectory}/release")
+        if (releaseFile.exists()) {
+            def implementorVersion = releaseFile.readLines().find { it.startsWith("IMPLEMENTOR_VERSION") }
+            if (implementorVersion) {
+                def version = implementorVersion.split("=")[1].trim().replaceAll('"', '')
+                new File("${project.ext.jdkBundlingDirectory}/VERSION").text = version
+            }
+        }
     }
