diff --git a/src/test/java/com/fasterxml/jackson/databind/jsontype/UseBaseTypeAsDefaultImplTest.java b/src/test/java/com/fasterxml/jackson/databind/jsontype/UseBaseTypeAsDefaultImplTest.java
new file mode 100644
index 000000000..a421ffebe
--- /dev/null
+++ b/src/test/java/com/fasterxml/jackson/databind/jsontype/UseBaseTypeAsDefaultImplTest.java
@@ -0,0 +1,46 @@
+package com.fasterxml.jackson.databind.jsontype;
+
+import com.fasterxml.jackson.annotation.JsonTypeInfo;
+import com.fasterxml.jackson.databind.*;
+
+public class UseBaseTypeAsDefaultImplTest extends BaseMapTest
+{
+    @JsonTypeInfo(use = JsonTypeInfo.Id.MINIMAL_CLASS, include = JsonTypeInfo.As.PROPERTY, property = "type")
+    interface MyInterface {
+        String getName();
+        void setName(String name);
+    }
+
+    static class MyClass implements MyInterface {
+        private String name;
+        public String getName() { return name; }
+        public void setName(String name) { this.name = name; }
+    }
+
+    // Test that with USE_BASE_TYPE_AS_DEFAULT_IMPL enabled, a concrete class
+    // can be deserialized even if the type property is missing in the JSON
+    public void testUseBaseTypeAsDefaultImpl() throws Exception
+    {
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.enable(MapperFeature.USE_BASE_TYPE_AS_DEFAULT_IMPL);
+
+        // JSON without type property, but we know the concrete type
+        String json = "{\"name\":\"testName\"}";
+        MyClass result = mapper.readValue(json, MyClass.class);
+        assertNotNull(result);
+        assertEquals("testName", result.getName());
+    }
+
+    // Test that without the feature, the exception is still thrown
+    public void testWithoutFeatureStillFails() throws Exception
+    {
+        ObjectMapper mapper = newObjectMapper();
+        String json = "{\"name\":\"testName\"}";
+        try {
+            mapper.readValue(json, MyClass.class);
+            fail("Should have thrown an exception when type property is missing");
+        } catch (Exception e) {
+            // expected
+        }
+    }
+}
