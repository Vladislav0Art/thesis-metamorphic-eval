diff --git a/subprojects/java21/src/test/java/org/mockito/java21/SpyAnnotationWithGenericTypeTest.java b/subprojects/java21/src/test/java/org/mockito/java21/SpyAnnotationWithGenericTypeTest.java
new file mode 100644
index 000000000..6f3348cb8
--- /dev/null
+++ b/subprojects/java21/src/test/java/org/mockito/java21/SpyAnnotationWithGenericTypeTest.java
@@ -0,0 +1,37 @@
+package org.mockito.java21;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+
+import java.util.List;
+import org.junit.After;
+import org.junit.Test;
+import org.mockito.MockitoAnnotations;
+import org.mockito.Spy;
+
+public class SpyAnnotationWithGenericTypeTest {
+
+    @Spy private final List<String> genericSpy = List.of("item A", "item B");
+
+    @Spy private ExampleRecord exampleRecord = new ExampleRecord("some value");
+
+    private AutoCloseable closeable;
+
+    @After
+    public void releaseMocks() throws Exception {
+        if (closeable != null) {
+            closeable.close();
+        }
+    }
+
+    @Test
+    public void genericSpyDoesNotBreakExistingInlineRecordSpy() {
+        closeable = MockitoAnnotations.openMocks(this);
+
+        assertEquals(List.of("item A", "item B"), genericSpy);
+        assertNotNull(exampleRecord.someParameter());
+        assertEquals("some value", exampleRecord.someParameter());
+    }
+
+    private record ExampleRecord(String someParameter) {}
+}
