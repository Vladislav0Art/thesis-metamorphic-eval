@@ -57,4 +57,19 @@ describe  FileWatch::BufferedTokenizer  do
       expect(subject.extract("foo||bar")).to eq(["foo"])
     end
   end
+
+  context "with size limit" do
+    subject { FileWatch::BufferedTokenizer.new(delimiter, size_limit) }
+
+    let(:delimiter) { "\n" }
+    let(:size_limit) { 10 }
+
+    it "discards buffered oversized payload and resumes after the next delimiter" do
+      expect(subject.extract("12345")).to eq([])
+
+      expect { subject.extract("678901\nabc\n") }.to raise_error(IllegalStateException, "input buffer full")
+
+      expect(subject.extract("def\n")).to eq(["abc", "def"])
+    end
+  end
 end
