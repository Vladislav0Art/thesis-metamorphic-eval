 package org.logstash.plugins.pipeline;
 
+import org.junit.Test;
+import org.logstash.ext.JrubyEventExtLibrary;
+
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.stream.Stream;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+public class PipelineBusV2Test {
+
+    @Test(timeout = 10000L)
+    public void mutateDoesNotDeadlockWhenNotificationContendsWithListenerMonitor() throws Exception {
+        final PipelineBusV2.AddressStateMapping mapping = new PipelineBusV2.AddressStateMapping();
+        final TestPipelineInput input = new TestPipelineInput();
+        final TestPipelineOutput output = new TestPipelineOutput();
+        final String address = "deadlock-test-address";
+
+        mapping.mutate(address, state -> {
+            state.assignInput(input);
+            state.assignOutput(output);
+        });
+
+        final CountDownLatch firstMutationEntered = new CountDownLatch(1);
+        final CountDownLatch allowFirstMutationToProceed = new CountDownLatch(1);
+        final CountDownLatch secondThreadHoldsInputMonitor = new CountDownLatch(1);
+        final AtomicReference<Throwable> threadFailure = new AtomicReference<>();
+
+        final Thread removeOutput = new Thread(() -> {
+            try {
+                mapping.mutate(address, state -> {
+                    firstMutationEntered.countDown();
+                    await(allowFirstMutationToProceed);
+                    state.unassignOutput(output);
+                });
+            } catch (Throwable t) {
+                threadFailure.compareAndSet(null, t);
+            }
+        }, "remove-output");
+        removeOutput.setDaemon(true);
+
+        final Thread removeInput = new Thread(() -> {
+            try {
+                synchronized (input) {
+                    secondThreadHoldsInputMonitor.countDown();
+                    mapping.mutate(address, state -> state.unassignInput(input));
+                }
+            } catch (Throwable t) {
+                threadFailure.compareAndSet(null, t);
+            }
+        }, "remove-input");
+        removeInput.setDaemon(true);
+
+        removeOutput.start();
+        assertThat(firstMutationEntered.await(5, TimeUnit.SECONDS)).isTrue();
+
+        removeInput.start();
+        assertThat(secondThreadHoldsInputMonitor.await(5, TimeUnit.SECONDS)).isTrue();
+
+        allowFirstMutationToProceed.countDown();
+
+        removeOutput.join(TimeUnit.SECONDS.toMillis(5));
+        removeInput.join(TimeUnit.SECONDS.toMillis(5));
+
+        assertThat(threadFailure.get()).isNull();
+        assertThat(removeOutput.isAlive()).isFalse();
+        assertThat(removeInput.isAlive()).isFalse();
+    }
+
+    private static void await(final CountDownLatch latch) {
+        try {
+            if (!latch.await(5, TimeUnit.SECONDS)) {
+                throw new AssertionError("timed out waiting for latch");
+            }
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            throw new AssertionError("interrupted while waiting for latch", e);
+        }
+    }
+
+    static class TestPipelineInput implements PipelineInput {
+        @Override
+        public ReceiveResponse internalReceive(final Stream<JrubyEventExtLibrary.RubyEvent> events) {
+            return ReceiveResponse.completed();
+        }
+
+        @Override
+        public String getId() {
+            return "test-input";
+        }
+
+        @Override
+        public boolean isRunning() {
+            return true;
+        }
+    }
+
+    static class TestPipelineOutput implements PipelineOutput {
+        @Override
+        public String getId() {
+            return "test-output";
+        }
+    }
+}
