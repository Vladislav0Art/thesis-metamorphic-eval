+    /**
+     * Returns the mock maker used by Mockito for the given built-in alias or fully qualified class name.
+     *
+     * <p>Unlike {@link #getDefaultPlugin(Class)}, this method may return a shared instance managed by
+     * Mockito. Passing {@code null} returns the default mock maker.
+     *
+     * @param mockMaker the built-in mock maker alias (see {@link MockMakers}) or fully qualified class
+     *     name; {@code null} returns the default mock maker
+     * @return the mock maker instance
+     */
+    default MockMaker getMockMaker(String mockMaker) {
